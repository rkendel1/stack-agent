{
  "name": "diagnostics_carry_no_prompt_or_credential",
  "behavior": "BM-15",
  "targets": [
    "native",
    "wasm"
  ],
  "support": 0,
  "request": {
    "v": 1,
    "model": "example/model-1",
    "messages": [
      {
        "role": "user",
        "parts": [
          {
            "type": "text",
            "text": "prompt sk-SECRETSECRETSECRET0123456789"
          }
        ]
      }
    ],
    "correlation": {
      "request_id": "00112233445566778899aabbccddeeff",
      "affinity_key": "session-sk-SECRETSECRETSECRET0123456789"
    }
  },
  "begin": {
    "status": "need_invoke"
  },
  "steps": [
    {
      "send": {
        "cmd": "invoke_result",
        "ok": true
      },
      "expect": {
        "status": "ready"
      }
    },
    {
      "send": {
        "cmd": "step"
      },
      "expect": {
        "status": "need_input",
        "events": []
      }
    },
    {
      "send": {
        "cmd": "feed_failure",
        "failure": {
          "kind": "provider_error",
          "observed": "invoked",
          "message": "Bearer sk-SECRETSECRETSECRET0123456789 rejected",
          "status": 401
        }
      },
      "expect": {
        "status": "ok"
      }
    },
    {
      "send": {
        "cmd": "step"
      },
      "expect": {
        "status": "done",
        "report": {
          "outcome": {
            "type": "failed",
            "kind": "unauthenticated"
          },
          "diagnostics": {
            "request_shape": {
              "text_parts": 1
            }
          }
        },
        "$excludes": {
          "at": "report.diagnostics",
          "values": [
            "sk-SECRETSECRETSECRET0123456789",
            "prompt"
          ]
        },
        "$excludes_all": [
          "sk-SECRETSECRETSECRET0123456789"
        ]
      }
    }
  ]
}
