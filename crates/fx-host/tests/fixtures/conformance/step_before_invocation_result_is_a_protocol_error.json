{
  "name": "step_before_invocation_result_is_a_protocol_error",
  "behavior": "host protocol",
  "targets": [
    "native",
    "wasm"
  ],
  "support": 0,
  "request": {
    "v": 1,
    "model": "example/model-1",
    "messages": [
      {
        "role": "user",
        "parts": [
          {
            "type": "text",
            "text": "say hi"
          }
        ]
      }
    ],
    "correlation": {
      "request_id": "00112233445566778899aabbccddeeff"
    }
  },
  "begin": {
    "status": "need_invoke"
  },
  "steps": [
    {
      "send": {
        "cmd": "step"
      },
      "expect": {
        "status": "error",
        "error": {
          "code": "bad_state"
        }
      }
    },
    {
      "send": {
        "cmd": "invoke_result",
        "ok": true
      },
      "expect": {
        "status": "ready"
      }
    },
    {
      "send": {
        "cmd": "step"
      },
      "expect": {
        "status": "need_input",
        "events": []
      }
    }
  ]
}
