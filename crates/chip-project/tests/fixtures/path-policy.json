  "manifests_description": "Cargo.toml writes, decided by content: before is the manifest on disk (null: none), after is what the write sends.",
  "manifests": [
    {
      "name": "add a dependency",
      "before": "[package]\nname = \"x\"\nversion = \"0.1.0\"\n\n[dependencies]\n",
      "after": "[package]\nname = \"x\"\nversion = \"0.1.0\"\n\n[dependencies]\nserde = \"1\"\n",
      "write": "allowed"
    },
    {
      "name": "create a manifest without a build script",
      "before": null,
      "after": "[package]\nname = \"x\"\nversion = \"0.1.0\"\n",
      "write": "allowed"
    },
    {
      "name": "keep an existing build setting while editing",
      "before": "[package]\nname = \"x\"\nbuild = \"gen.rs\"\n",
      "after": "[package]\nname = \"x\"\nbuild = \"gen.rs\"\n\n[dependencies]\nlog = \"0.4\"\n",
      "write": "allowed"
    },
    {
      "name": "turn the default build script off",
      "before": "[package]\nname = \"x\"\n",
      "after": "[package]\nname = \"x\"\nbuild = false\n",
      "write": "allowed"
    },
    {
      "name": "name a new build script",
      "before": "[package]\nname = \"x\"\n",
      "after": "[package]\nname = \"x\"\nbuild = \"src/gen.rs\"\n",
      "write": "protected",
      "rule": "cargo-manifest-build"
    },
    {
      "name": "create a manifest that names a build script",
      "before": null,
      "after": "[package]\nname = \"x\"\nbuild = 'tools/b.rs'\n",
      "write": "protected",
      "rule": "cargo-manifest-build"
    },
    {
      "name": "point an existing build setting elsewhere",
      "before": "[package]\nbuild = \"a.rs\"\n",
      "after": "[package]\nbuild = \"b.rs\"\n",
      "write": "protected",
      "rule": "cargo-manifest-build"
    },
    {
      "name": "quoted key",
      "before": "[package]\nname = \"x\"\n",
      "after": "[package]\nname = \"x\"\n\"build\" = \"b.rs\"\n",
      "write": "protected",
      "rule": "cargo-manifest-build"
    },
    {
      "name": "a nested manifest is checked the same way",
      "path": "crates/a/Cargo.toml",
      "before": "[package]\nname = \"a\"\n",
      "after": "[package]\nname = \"a\"\nbuild = \"b.rs\"\n",
      "write": "protected",
      "rule": "cargo-manifest-build"
    }
  ]
