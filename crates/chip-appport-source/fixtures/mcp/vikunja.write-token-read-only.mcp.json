{
  "schema": "chip.appport-mcp-snapshot.v1",
  "label": "write-token-read-only",
  "bridge": {
    "repository": "https://github.com/rkendel1/vikunja",
    "path": "appport-bridge",
    "commit": "851a9da34e1583202d9c14fb3259bef0eb0ea120",
    "packages": {
      "@appport/sdk": "1.2.2",
      "@appport/mcp": "1.3.0",
      "@modelcontextprotocol/sdk": "1.32.1"
    }
  },
  "application": {
    "name": "Vikunja",
    "version": "dev",
    "built_from": "851a9da34e1583202d9c14fb3259bef0eb0ea120",
    "database": "sqlite (disposable)"
  },
  "grant": {
    "scopes": [
      "vikunja.read",
      "vikunja.tasks.write"
    ],
    "credential": "bob: Vikunja API token, projects read_all/read_one, tasks read_one"
  },
  "initialize": {
    "protocolVersion": "2025-06-18",
    "capabilities": {
      "tools": {
        "listChanged": false
      }
    },
    "serverInfo": {
      "name": "Vikunja",
      "version": "appport-bridge-1"
    }
  },
  "tools": [
    {
      "name": "vikunja_projects_list",
      "description": "List the projects Vikunja lets the caller see.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "includeArchived": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Negative ids are Vikunja's virtual projects (saved filters), not stored projects"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "parentProjectId": {
                  "type": "integer"
                },
                "isArchived": {
                  "type": "boolean"
                },
                "owner": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "virtual": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "description",
                "parentProjectId",
                "isArchived",
                "owner",
                "virtual"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "projects"
        ]
      },
      "_meta": {
        "dev.appport/capability": {
          "name": "vikunja.projects.list",
          "version": 1,
          "authorization": [
            "vikunja.read"
          ],
          "effect": "observation",
          "idempotency": "unsupported",
          "authorizationContract": {
            "required": true,
            "scopes": [
              "vikunja.read"
            ]
          },
          "integration": {
            "purpose": "List projects visible to the caller.",
            "authority": "urn:appport:vikunja",
            "access": [
              {
                "resource": "urn:appport:vikunja:projects",
                "mode": "reads"
              }
            ],
            "approval": {
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "vikunja_tasks_get",
      "description": "Retrieve one task, including its done status, if Vikunja lets the caller read it.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "projectId": {
            "type": "integer"
          },
          "done": {
            "type": "boolean"
          },
          "doneAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "integer"
          },
          "percentDone": {
            "type": "number"
          },
          "identifier": {
            "type": "string"
          },
          "createdBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "created": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "projectId",
          "done",
          "doneAt",
          "dueDate",
          "priority",
          "percentDone",
          "identifier",
          "createdBy",
          "created",
          "updated"
        ]
      },
      "_meta": {
        "dev.appport/capability": {
          "name": "vikunja.tasks.get",
          "version": 1,
          "authorization": [
            "vikunja.read"
          ],
          "effect": "observation",
          "idempotency": "unsupported",
          "authorizationContract": {
            "required": true,
            "scopes": [
              "vikunja.read"
            ]
          },
          "integration": {
            "purpose": "Read a task and its status.",
            "authority": "urn:appport:vikunja",
            "access": [
              {
                "resource": "urn:appport:vikunja:tasks",
                "mode": "reads"
              }
            ],
            "approval": {
              "required": false
            }
          }
        }
      }
    },
    {
      "name": "vikunja_tasks_setdone",
      "description": "Mark a task done or not done. Vikunja checks that the caller may update the task.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "done": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "done"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "projectId": {
            "type": "integer"
          },
          "done": {
            "type": "boolean"
          },
          "doneAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "dueDate": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "priority": {
            "type": "integer"
          },
          "percentDone": {
            "type": "number"
          },
          "identifier": {
            "type": "string"
          },
          "createdBy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "created": {
            "type": "string"
          },
          "updated": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "projectId",
          "done",
          "doneAt",
          "dueDate",
          "priority",
          "percentDone",
          "identifier",
          "createdBy",
          "created",
          "updated"
        ]
      },
      "_meta": {
        "dev.appport/capability": {
          "name": "vikunja.tasks.setdone",
          "version": 1,
          "authorization": [
            "vikunja.tasks.write"
          ],
          "effect": "consequential",
          "idempotency": "unsupported",
          "authorizationContract": {
            "required": true,
            "scopes": [
              "vikunja.tasks.write"
            ]
          },
          "integration": {
            "purpose": "Set a task's done flag.",
            "authority": "urn:appport:vikunja",
            "effects": [
              {
                "type": "urn:appport:vikunja#task-done-changed",
                "description": "The task's done flag (and Vikunja's done_at) change."
              }
            ],
            "verify": [
              {
                "id": "task-done-stored",
                "kind": "state",
                "via": {
                  "capability": "vikunja.tasks.get",
                  "version": 1,
                  "input": {
                    "id": {
                      "$input": "/id"
                    }
                  }
                },
                "expect": [
                  {
                    "at": "/done",
                    "equals": {
                      "$input": "/done"
                    }
                  }
                ]
              }
            ],
            "access": [
              {
                "resource": "urn:appport:vikunja:tasks",
                "mode": "changes",
                "operations": [
                  "update"
                ]
              }
            ],
            "approval": {
              "required": false
            },
            "failures": [
              {
                "code": "FORBIDDEN",
                "retry": "unsafe",
                "effect": "none",
                "description": "Vikunja refused: the caller may not update this task."
              },
              {
                "code": "NOT_FOUND",
                "retry": "unsafe",
                "effect": "none"
              },
              {
                "code": "INTERNAL_ERROR",
                "retry": "after-verification",
                "effect": "unknown",
                "description": "Read the task before trying again."
              }
            ]
          }
        }
      }
    }
  ],
