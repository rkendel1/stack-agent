@@@@ NEW tests/retry_policy.rs
//! Configurable retry policies: `[retry]` reaches the executor through the public configuration
//! path, defaults are unchanged, and invalid values are rejected.

mod common;

use common::{rig, rig_with_env};
use courier::config;
use courier::transport::mock::{ok, retry_after, status};
use courier::ErrorKind;
use std::time::Duration;

#[test]
fn the_default_policy_is_unchanged() {
    let r = rig("", vec![status(503), status(503), status(503), ok()]);
    let e = r.client.get("http://h/a").unwrap_err();
    assert_eq!(e.kind, ErrorKind::RetriesExhausted);
    assert_eq!(e.attempts, 3);
    assert_eq!(r.clock.slept(), vec![Duration::from_millis(100), Duration::from_millis(200)]);
}

#[test]
fn max_attempts_is_configurable() {
    let r = rig("[retry]\nmax_attempts = 5\n", vec![status(503), status(503), status(503), status(503), ok()]);
    assert!(r.client.get("http://h/a").is_ok());
    assert_eq!(r.transport.calls(), 5);
}

#[test]
fn a_single_attempt_means_no_retries() {
    let r = rig("[retry]\nmax_attempts = 1\n", vec![status(503), ok()]);
    let e = r.client.get("http://h/a").unwrap_err();
    assert_eq!(e.kind, ErrorKind::RetriesExhausted);
    assert_eq!(r.transport.calls(), 1);
    assert!(r.clock.slept().is_empty());
}

#[test]
fn retries_stay_bounded_however_the_server_behaves() {
    let r = rig("[retry]\nmax_attempts = 4\n", vec![retry_after(429, 1); 20]);
    let e = r.client.get("http://h/a").unwrap_err();
    assert_eq!(e.attempts, 4);
    assert_eq!(r.transport.calls(), 4);
}

#[test]
fn the_backoff_curve_is_configurable() {
    let r = rig(
        "[retry]\nmax_attempts = 4\nbase_delay = 1s\nfactor = 3\nmax_delay = 20s\n",
        vec![status(500), status(500), status(500), ok()],
    );
    assert!(r.client.get("http://h/a").is_ok());
    assert_eq!(
        r.clock.slept(),
        vec![Duration::from_secs(1), Duration::from_secs(3), Duration::from_secs(9)]
    );
}

#[test]
fn max_delay_bounds_the_computed_backoff() {
    let r = rig(
        "[retry]\nmax_attempts = 5\nbase_delay = 1s\nfactor = 4\nmax_delay = 3s\n",
        vec![status(500), status(500), status(500), status(500), ok()],
    );
    assert!(r.client.get("http://h/a").is_ok());
    assert!(r.clock.slept().iter().all(|d| *d <= Duration::from_secs(3)));
}

#[test]
fn max_delay_does_not_shorten_a_server_hint() {
    let r = rig("[retry]\nmax_delay = 1s\n", vec![retry_after(503, 30), ok()]);
    assert!(r.client.get("http://h/a").is_ok());
    assert_eq!(r.clock.slept(), vec![Duration::from_secs(30)]);
}

#[test]
fn the_server_hint_can_be_ignored() {
    let r = rig("[retry]\nhonor_retry_after = false\n", vec![retry_after(503, 30), ok()]);
    assert!(r.client.get("http://h/a").is_ok());
    assert_eq!(r.clock.slept(), vec![Duration::from_millis(100)]);
}

#[test]
fn terminal_failures_are_never_retried_whatever_the_policy() {
    let r = rig("[retry]\nmax_attempts = 10\n", vec![status(404), ok()]);
    let e = r.client.get("http://h/a").unwrap_err();
    assert_eq!(e.kind, ErrorKind::Status);
    assert_eq!(r.transport.calls(), 1);
}

#[test]
fn the_environment_overrides_the_file() {
    let r = rig_with_env(
        "[retry]\nmax_attempts = 2\n",
        &[("COURIER_RETRY_MAX_ATTEMPTS", "4")],
        vec![status(503), status(503), status(503), ok()],
    );
    assert!(r.client.get("http://h/a").is_ok());
}

#[test]
fn a_route_without_its_own_retry_settings_uses_the_client_policy() {
    let cfg = "[retry]\nmax_attempts = 5\n[route.reports]\nprefix = /reports\ntimeout = 30s\n";
    let r = rig(cfg, vec![status(503), status(503), status(503), status(503), ok()]);
    assert!(r.client.get("http://h/reports/q1").is_ok());
    assert_eq!(r.transport.calls(), 5);
}

#[test]
fn invalid_values_are_rejected_when_the_configuration_loads() {
    for bad in [
        "[retry]\nmax_attempts = 0\n",
        "[retry]\nmax_attempts = 11\n",
        "[retry]\nbase_delay = 0ms\n",
        "[retry]\nfactor = 0\n",
        "[retry]\nbase_delay = 2s\nmax_delay = 1s\n",
        "[retry]\nmax_attempts = many\n",
        "[retry]\nbase_delay = 100\n",
    ] {
        assert!(config::load(bad, &[]).is_err(), "should be rejected: {bad:?}");
    }
}

#[test]
fn the_retry_section_round_trips_through_show() {
    let text = "[retry]\nmax_attempts = 6\nbase_delay = 250ms\nfactor = 3\nmax_delay = 10s\nhonor_retry_after = false\n";
    let c = config::load(text, &[]).unwrap().config;
    let again = config::load(&config::render::render(&c), &[]).unwrap().config;
    assert_eq!(c.retry, again.retry);
}
