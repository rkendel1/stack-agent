@@@@ NEW src/exec/policy.rs
//! A configurable retry policy: how many attempts a request gets and how it waits between them.

use super::backoff::Backoff;
use super::retry::Retry;
use crate::error::CourierError;
use std::time::Duration;

/// The most attempts any policy may allow.
pub const MAX_ATTEMPTS_LIMIT: u32 = 10;
/// The largest backoff factor a policy may use.
pub const MAX_FACTOR: u32 = 10;

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct RetryPolicy {
    /// Attempts allowed for one request, the first included.
    pub max_attempts: u32,
    /// Wait after the first failed attempt.
    pub base_delay: Duration,
    /// Multiplier applied to the wait after each further failure.
    pub factor: u32,
    /// Longest a computed backoff may grow to. A server `Retry-After` is not bounded by it.
    pub max_delay: Duration,
    /// Whether a server `Retry-After` can lengthen the wait.
    pub honor_retry_after: bool,
}

impl RetryPolicy {
    /// The behaviour every release before retries became tunable had: three attempts, waiting
    /// 100ms and then 200ms, growing to at most 5s, following the server's `Retry-After`.
    pub const fn standard() -> Self {
        Self {
            max_attempts: 3,
            base_delay: Duration::from_millis(100),
            factor: 2,
            max_delay: Duration::from_secs(5),
            honor_retry_after: true,
        }
    }

    pub fn validate(&self) -> Result<(), CourierError> {
        if self.max_attempts == 0 || self.max_attempts > MAX_ATTEMPTS_LIMIT {
            return Err(CourierError::config(format!(
                "[retry] max_attempts must be between 1 and {MAX_ATTEMPTS_LIMIT}"
            )));
        }
        if self.base_delay.is_zero() {
            return Err(CourierError::config("[retry] base_delay must be greater than zero"));
        }
        if self.factor == 0 || self.factor > MAX_FACTOR {
            return Err(CourierError::config(format!(
                "[retry] factor must be between 1 and {MAX_FACTOR}"
            )));
        }
        if self.max_delay < self.base_delay {
            return Err(CourierError::config("[retry] max_delay must not be shorter than base_delay"));
        }
        Ok(())
    }

    pub fn retry(&self) -> Retry {
        Retry::new(self.max_attempts)
    }

    pub fn backoff(&self) -> Backoff {
        Backoff::exponential(self.base_delay, self.factor, self.max_delay)
    }
}

impl Default for RetryPolicy {
    fn default() -> Self {
        Self::standard()
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn standard_matches_the_original_constants() {
        let p = RetryPolicy::standard();
        assert_eq!(p.retry(), Retry::standard());
        assert_eq!(p.backoff(), Backoff::standard());
        assert!(p.honor_retry_after);
        assert!(p.validate().is_ok());
    }

    #[test]
    fn attempts_are_bounded() {
        let mut p = RetryPolicy::standard();
        p.max_attempts = 0;
        assert!(p.validate().is_err());
        p.max_attempts = MAX_ATTEMPTS_LIMIT;
        assert!(p.validate().is_ok());
        p.max_attempts = MAX_ATTEMPTS_LIMIT + 1;
        assert!(p.validate().is_err());
    }

    #[test]
    fn delays_must_be_sane() {
        let mut p = RetryPolicy::standard();
        p.base_delay = Duration::ZERO;
        assert!(p.validate().is_err());
        p = RetryPolicy::standard();
        p.max_delay = Duration::from_millis(50);
        assert!(p.validate().is_err());
    }

    #[test]
    fn factor_is_bounded() {
        let mut p = RetryPolicy::standard();
        p.factor = 0;
        assert!(p.validate().is_err());
        p.factor = MAX_FACTOR + 1;
        assert!(p.validate().is_err());
        p.factor = 1;
        assert!(p.validate().is_ok());
    }

    #[test]
    fn builds_the_matching_retry_and_backoff() {
        let p = RetryPolicy {
            max_attempts: 5,
            base_delay: Duration::from_secs(1),
            factor: 3,
            max_delay: Duration::from_secs(20),
            honor_retry_after: false,
        };
        assert_eq!(p.retry().max_attempts(), 5);
        assert_eq!(p.backoff().delay(3), Duration::from_secs(9));
    }
}
@@@@ END
