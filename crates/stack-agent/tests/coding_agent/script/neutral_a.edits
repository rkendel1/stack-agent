    pub fn from_config(config: &Config) -> Self {
        let base = ExecSettings::from_config(config);
        let mut table = Self::new(base);
        for r in &config.routes {
            let overrides = RouteOverrides::from(r);
            table.add(&r.name, &r.prefix, overrides);
        }
        table
