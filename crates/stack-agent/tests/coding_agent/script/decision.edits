        // Retry settings decide how hard the client pushes on a failing server (ADR-009): a
        // misspelt key must not silently leave the default in force.
        if let Some(key) = f.values.keys().next() {
            return Err(CourierError::config(format!("[retry] unknown key `{key}`")));
        }

        let mut routes = Vec::new();
