@@@@ EDIT tests/retry_policy.rs
@@@@ FIND

#[test]
fn unknown_retry_keys_are_rejected() {
    let e = config::load("[retry]\nmax_attemps = 5\n", &[]).unwrap_err();
    assert!(e.message.contains("unknown key `max_attemps`"));
}
@@@@ REPLACE

#[test]
fn unknown_retry_keys_warn_like_every_other_section() {
    let loaded = config::load("[retry]\nmax_attemps = 5\n", &[]).unwrap();
    assert_eq!(loaded.warnings, vec!["[retry] unknown key `max_attemps` ignored"]);
    assert_eq!(loaded.config.retry.max_attempts, 3, "the misspelt key changes nothing");
}
