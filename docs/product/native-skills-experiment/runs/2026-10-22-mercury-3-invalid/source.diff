+/// Its id is `inner`'s.
+pub struct WithInstructions<'a> {
+    pub inner: &'a dyn EscalationContextPolicy,
+    pub instructions: &'a AddedInstructions,
+}
+
+impl EscalationContextPolicy for WithInstructions<'_> {
+    fn id(&self) -> &'static str {
