{"decision":"request_capability","capability":"project.write","inputs":{"path":"packages/server/src/connection.ts","expected_sha256":"f1d9027fbaa65224b699eb4c3029f05d0ee3a48becb845a5ffead7ee1a962ea1","content":"import {\n  AppPortError,\n  createErrorResponse,\n  createStreamChunk,\n  createStreamEnd,\n  createStreamStart,\n  createSuccessResponse,\n  decodeEnvelopeText,\n  errors,\n  parseClientEnvelope,\n  peekRequestId,\n  peekTraceId,\n  type AppEventEnvelope,\n  type ClientEnvelope,\n  type ServerEnvelope,\n  type Principal,\n  type Session\n} from \"@appport/protocol\";\nimport { grantsPermission } from \"@appport/authorization\";\nimport { toWireError, type AppPortApplication, type StreamExecution } from \"@appport/core/server-internal\";\n\nexport type SendEnvelope = (envelope: ServerEnvelope) => void | Promise<void>;\n\nexport interface ConnectionOptions {\n  application: AppPortApplication;\n  /** Transport kind, recorded for telemetry. Never a source of trust (§37). */\n  transport: string;\n  send: SendEnvelope;\n  session?: Session;\n  principal?: Principal;\n  maxEnvelopeBytes?: number;\n  /** Capability/event names this transport surface may reach. */\n  allowedCapabilities?: ReadonlySet<string>;\n}\n\ninterface ActiveStream {\n  execution: StreamExecution;\n  abort: AbortController;\n}\n\n/**\n * One duplex client connection.\n *\n * Connections exist for transports that can push (WebSocket, IPC, in-process).\n * They own the subscription and stream bookkeeping the protocol requires:\n * unsubscribe releases resources (§18), cancellation terminates the underlying\n * operation (§21).\n */\nexport class AppPortConnection {\n  readonly transport: string;\n  readonly #application: AppPortApplication;\n  readonly #send: SendEnvelope;\n  readonly #subscriptions = new Map<string, () => void>();\n  readonly #streams = new Map<string, ActiveStream>();\n  readonly #maxEnvelopeBytes: number | undefined;\n  readonly #allowedCapabilities: ReadonlySet<string> | undefined;\n  #session: Session | undefined;\n  #principal: Principal | undefined;\n  #closed = false;\n\n  constructor(options: ConnectionOptions) {\n    this.#application = options.application;\n    this.transport = options.transport;\n    this.#send = options.send;\n    this.#session = options.session;\n    this.#principal = options.principal;\n    this.#maxEnvelopeBytes = options.maxEnvelopeBytes;\n    this.#allowedCapabilities = options.allowedCapabilities;\n  }\n\n  get session(): Session | undefined {\n    return this.#session;\n  }\n\n  get closed(): boolean {\n    return this.#closed;\n  }\n\n  get openStreamCount(): number {\n    return this.#streams.size;\n  }\n\n  get subscriptionCount(): number {\n    return this.#subscriptions.size;\n  }\n\n  /** Binds an authenticated identity to this connection. */\n  authenticate(identity: { session?: Session; principal?: Principal }): void {\n    this.#session = identity.session;\n    this.#principal = identity.principal ?? identity.session?.principal;\n  }\n\n  /** Accepts a raw text frame. */\n  async accept(raw: string): Promise<void> {\n    let value: unknown;\n    try {\n      value = decodeEnvelopeText(raw, this.#maxEnvelopeBytes ? { maxBytes: this.#maxEnvelopeBytes } : {});\n    } catch (error) {\n      await this.#fail(undefined, undefined, error);\n      return;\n    }\n    await this.acceptValue(value);\n  }\n\n  /** Accepts an already-decoded envelope value (IPC and in-process transports). */\n  async acceptValue(value: unknown): Promise<void> {\n    const requestId = peekRequestId(value);\n    const traceId = peekTraceId(value);\n    let envelope: ClientEnvelope;\n    try {\n      envelope = parseClientEnvelope(value);\n    } catch (error) {\n      await this.#fail(requestId, traceId, error);\n      return;\n    }\n    await this.handle(envelope);\n  }\n\n  /** Routes a validated client envelope. */\n  async handle(envelope: ClientEnvelope): Promise<void> {\n    if (this.#closed) return;\n    const target = envelope.type === \"request\" || envelope.type === \"stream.request\"\n      ? envelope.capability.name\n      : envelope.type === \"subscribe\"\n        ? envelope.event.name\n        : undefined;\n    if (target && this.#allowedCapabilities && target !== \"appport.manifest\" && target !== \"appport.ping\" && !this.#allowedCapabilities.has(target)) {\n      await this.#emit(createErrorResponse(peekRequestId(envelope) ?? \"req_unknown\", errors.forbidden(`${target} is not exposed to this surface`).toErrorObject()));\n      return;\n    }\n    switch (envelope.type) {\n      case \"request\": {\n        const response = await this.#application.handleRequest(envelope, this.#dispatchOptions());\n        await this.#emit(response);\n        return;\n      }\n      case \"stream.request\": {\n        await this.#startStream(envelope);\n        return;\n      }\n      case \"subscribe\": {\n        await this.#subscribe(envelope);\n        return;\n      }\n      case \"unsubscribe\": {\n        const release = this.#subscriptions.get(envelope.subscriptionId);\n        release?.();\n        this.#subscriptions.delete(envelope.subscriptionId);\n        await this.#emit(\n          createSuccessResponse(envelope.requestId, { subscriptionId: envelope.subscriptionId, active: false })\n        );\n        return;\n      }\n      case \"stream.cancel\": {\n        const active = this.#streams.get(envelope.streamId);\n        active?.execution.cancel(envelope.reason);\n        active?.abort.abort();\n        return;\n      }\n    }\n  }\n\n  /** Releases every subscription and stream held by this connection. */\n  close(): void {\n    if (this.#closed) return;\n    this.#closed = true;\n    for (const release of this.#subscriptions.values()) release();\n    this.#subscriptions.clear();\n    for (const active of this.#streams.values()) {\n      active.execution.cancel(\"Connection closed\");\n      active.abort.abort();\n    }\n    this.#streams.clear();\n  }\n\n  #dispatchOptions() {\n    return {\n      ...(this.#session ? { session: this.#session } : {}),\n      ...(this.#principal ? { principal: this.#principal } : {}),\n      transport: this.transport\n    };\n  }\n\n  /** Permissions an event version requires to be observed (§9.4, §12.3). */\n  #requiredToObserve(name: string, version?: number): readonly string[] {\n    const registry = this.#application.registry;\n    const definition = registry.getEvent(name, version) ?? (version !== undefined ? registry.getEvent(name) : undefined);\n    return definition?.authorization ?? [];\n  }\n\n  /** True when this connection's session may observe every listed permission. */\n  #grants(required: readonly string[]): boolean {\n    if (required.length === 0) return true;\n    const granted = this.#session?.permissions ?? [];\n    return required.every((permission) => grantsPermission(granted, permission));\n  }\n\n  async #subscribe(envelope: Extract<ClientEnvelope, { type: \"subscribe\" }>): Promise<void> {\n    const name = envelope.event.name;\n    const required = name === \"*\" || name.endsWith(\".*\") ? [] : this.#requiredToObserve(name, envelope.event.version);\n    if (!this.#grants(required)) {\n      const error = this.#principal\n        ? errors.forbidden(`Missing permission to observe ${name}`)\n        : errors.unauthorized();\n      await this.#emit(createErrorResponse(envelope.requestId, error.toErrorObject()));\n      return;\n    }\n\n    if (this.#subscriptions.has(envelope.subscriptionId)) {\n      await this.#emit(\n        createErrorResponse(\n          envelope.requestId,\n          errors.conflict(`Subscription ${envelope.subscriptionId} already exists`).toErrorObject()\n        )\n      );\n      return;\n    }\n\n    const release = this.#application.subscribe(\n      envelope.event.version === undefined ? { name } : { name, version: envelope.event.version },\n      (event: AppEventEnvelope) => {\n        // Wildcard subscriptions (`*`, `documents.*`) match events