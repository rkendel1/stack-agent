+/**
+ * The capability version a provider offers for a requirement: among the provider's versions of the required
+ * capability that satisfy the requirement's version constraint, the highest. A provider may serve several versions of
+ * one capability name; every one of them is considered, never only the first declared.
+ */
+function satisfyingCapability(
+  requirement: RequirementWithConstraints,
+  provider: ApplicationState
+): CapabilityManifestEntry | undefined {
+  const versionConstraint = requirement.versionConstraint || String(requirement.version);
+  let selected: CapabilityManifestEntry | undefined;
+  for (const capability of provider.manifest.provides) {
+    if (capability.name !== requirement.name) continue;
+    if (!satisfiesVersionConstraint(capability.version, versionConstraint)) continue;
+    if (!selected || capability.version > selected.version) selected = capability;
+  }
+  return selected;
+}
