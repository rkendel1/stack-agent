{"decision":"request_capability","capability":"project.write","inputs":{"path":"packages/core/src/resolver.ts","expected_sha256":"4d4cf71cd398d316a790d88ea5508d5848b2a072c99aff05681979b2259476c2","content":"/**\n * Application Dependency Resolver (PR22)\n *\n * Deterministic resolution of application capability requirements against\n * the Application Registry.\n *\n * Key principles:\n * - Discovery via ApplicationRegistry (who provides this capability?)\n * - Compatibility evaluation (can this provider satisfy this requirement?)\n * - Lifecycle eligibility: retired providers are never candidates; among compatible providers, a promoted (`active`)\n *   one excludes those that are only `registered`, so preparing a replacement never displaces or makes ambiguous the\n *   provider in service. With no active provider, registered providers resolve as they always have.\n * - Deterministic selection (same registry state always produces same result)\n * - No authorization checks (authorization is a separate layer)\n * - No execution (resolution produces metadata only)\n */\n\nimport type { ApplicationState } from \"./state.js\";\nimport type { ApplicationRegistry } from \"./registration.js\";\nimport type { CapabilityManifestEntry, RequirementManifestEntry, ApplicationManifest } from \"./manifest.js\";\nimport { attestResolution } from \"./authority-attestation.js\";\nimport {\n  claimsFor,\n  evaluateFulfillment,\n  findCapabilityVersion,\n  type AuthorityEquivalence,\n  type FulfillmentClaim,\n  type FulfillmentEvaluation,\n  type FulfillmentStatus\n} from \"@appport/protocol\";\nimport { toProtocolManifest, type CanonicalContractRecord, type CanonicalContractRegistry } from \"./canonical-contracts.js\";\n\n/**\n * Extended requirement with version constraint and provider constraint support.\n *\n * Extends RequirementManifestEntry to support semantic version constraints\n * and provider constraints for deterministic resolution.\n */\nexport interface RequirementWithConstraints extends RequirementManifestEntry {\n  readonly versionConstraint?: string; // e.g., \"1\", \"^1\", \"~1.2\", \">=2\"\n  readonly provider?: {\n    readonly applicationId?: string;\n  };\n}\n\n/**\n * Compatibility result: detailed assessment of whether a provider can satisfy a requirement.\n */\nexport interface CompatibilityResult {\n  readonly compatible: boolean;\n  readonly reasons: readonly string[];\n}\n\n/**\n * A resolved requirement: provider has been selected.\n */\nexport interface ResolvedRequirement {\n  readonly kind: \"resolved\";\n  readonly requirement: RequirementWithConstraints;\n  readonly provider: ApplicationState;\n  readonly capability: CapabilityManifestEntry;\n  readonly compatibility: CompatibilityResult;\n  /** For a canonical requirement: the evaluation of the claim that made this provider eligible. */\n  readonly fulfillment?: FulfillmentEvaluation;\n  /**\n   * For a canonical requirement: which exact canonical revision justified selecting which exact provider registration.\n   * Present exactly when `requirement.canonical` is, on resolutions the resolver produced.\n   */\n  readonly canonical?: CanonicalResolutionEvidence;\n}\n\n/**\n * Both sides of a canonical resolution, pinned. The canonical side and the provider side are separate identities and\n * are never collapsed into one: `capability` is the canonical capability, `provider.capability` the provider's own.\n */\nexport interface CanonicalResolutionEvidence {\n  /** The canonical contract revision evaluated: its id, registry revision number and `contractDigest`. */\n  readonly contract: { readonly id: string; readonly revision: number; readonly digest: string };\n  /** The canonical capability version evaluated, and the `capabilityDigest` it had when evaluated. */\n  readonly capability: { readonly name: string; readonly version: number; readonly digest: string };\n  /** The provider registration incarnation and its own capability version holding the claim. */\n  readonly provider: {\n    readonly application: string;\n    readonly registrationId: string;\n    readonly fingerprint: string;\n    readonly revision: number;\n    readonly capability: { readonly name: string; readonly version: number };\n  };\n  /** The claim evaluated, exactly as the provider published it. */\n  readonly claim: FulfillmentClaim;\n  /** The claim's fulfillment status, and whether the provider's interface is structurally compatible. */\n  readonly status: FulfillmentStatus;\n  readonly compatible: boolean;\n  /**\n   * `required`: the permissions the canonical capability requires, authoritative for the request. `enforced`: the\n   * permissions the provider capability actually enforces. `mapping`: the claim's declared canonical → provider mapping,\n   * established (or not) by the evaluation. None of these grants anything to a caller.\n   */\n  readonly authority: {\n    readonly required: readonly string[];\n    readonly enforced: readonly string[];\n    readonly mapping?: Readonly<Record<string, readonly string[]>>;\n  };\n}\n\n/** One evaluated claim found by canonical discovery. */\nexport interface CanonicalCandidate {\n  readonly provider: ApplicationState;\n  /** The provider's own capability version holding the claim. */\n  readonly capability: CapabilityManifestEntry;\n  readonly evaluation: FulfillmentEvaluation;\n  readonly evidence: CanonicalResolutionEvidence;\n  /** `evaluation.status === \"valid\"`: the only claims that may be resolved. */\n  readonly eligible: boolean;\n}\n\n/** What to discover: a canonical capability and the canonical versions acceptable. */\nexport interface CanonicalDiscoveryQuery {\n  readonly contract: string;\n  readonly capability: string;\n  /** Major-version constraint on the canonical capability, as for requirements (`1`, `^1`, `>=2`, …). */\n  readonly versionConstraint: string;\n  /** Restrict to claims made by this application. */\n  readonly provider?: string;\n}\n\n/**\n * The result of a deterministic registry query for providers of a canonical capability. `candidates` is every claim\n * evaluated against the current contract revision, eligible or not, in a stable order; `eligible` the valid ones. No\n * lifecycle preference, ranking or selection is applied: that is resolution's job.\n */\nexport type CanonicalDiscovery =\n  | { readonly kind: \"unavailable\"; readonly reason: string }\n  | {\n      readonly kind: \"discovered\";\n      readonly contract: Pick<CanonicalContractRecord, \"id\" | \"revision\" | \"digest\" | \"status\">;\n      /** Canonical versions satisfying the constraint. */\n      readonly versions: readonly number[];\n      readonly candidates: readonly CanonicalCandidate[];\n      readonly eligible: readonly CanonicalCandidate[];\n    };\n\n/**\n * An unresolved requirement: no compatible provider found.\n */\nexport interface UnresolvedRequirement {\n  readonly kind: \"unresolved\";\n  readonly requirement: RequirementWithConstraints;\n  readonly candidates: readonly ApplicationState[];\n  readonly reason: string;\n  /** For a canonical requirement: every claim that was evaluated, and why none qualified. */\n  readonly evaluations?: readonly FulfillmentEvaluation[];\n}\n\n/**\n * An ambiguous requirement: multiple equally valid providers exist.\n */\nexport interface AmbiguousRequirement {\n  readonly kind: \"ambiguous\";\n  readonly requirement: RequirementWithConstraints;\n  readonly candidates: readonly ApplicationState[];\n  /** For a canonical requirement: the valid fulfillments that could not be told apart. */\n  readonly evaluations?: readonly FulfillmentEvaluation[];\n}\n\n/** What the resolver needs to resolve canonical requirements. Name-only resolution needs neither. */\nexport interface ResolverOptions {\n  /** The canonical contracts canonical requirements resolve against. */\n  readonly contracts?: CanonicalContractRegistry;\n  /** Explicit authority equivalence decisions made by whoever owns this registry. */\n  readonly authorityDecisions?: readonly AuthorityEquivalence[];\n}\n\n/**\n * A resolution result: resolved, unresolved, or ambiguous.\n */\nexport type ResolutionResult = ResolvedRequirement | UnresolvedRequirement | AmbiguousRequirement;\n\n/**\n * Full application resolution: all requirements resolved/unresolved/ambiguous.\n */\nexport interface ApplicationResolution {\n  readonly application: ApplicationState;\n  readonly results: readonly ResolutionResult[];\n  readonly resolved: readonly ResolvedRequirement[];\n  readonly unresolved: readonly UnresolvedRequirement[];\n  readonly ambiguous: readonly AmbiguousRequirement[];\n}\n\n/**\n * Parse a semantic version constraint string and check if a provided version satisfies it.\n *\n * Supports:\n * - Exact: \"1\" (matches 1 only)\n * - Caret: \"^1\" (matches 1.x.x, i.e., >= 1 and < 2)\n * - Tilde: \"~1.2\" (matches 1.2.x, i.e., >= 1.2 and < 1.3, but for major version numbers)\n * - Comparison: \">=1\", \">1\", \"<=1\", \"<1\"\n *\n * Returns true if the provided version satisfies the constraint.\n */\nexport function satisfiesVersionConstraint(providedVersion: number, constraint: string): boolean {\n  const trimmed = constraint.trim();\n\n  // Caret range: ^1 matches >= 1 and < 2\n  if (trimmed.startsWith(\"^\")) {\n    const versionStr = trimmed.substring(1);\n    const [major] = versionStr.split(\".\").map(Number);\n    return providedVersion >= major && providedVersion < major + 1;\n  }\n\n  // Tilde range: ~1.2 matches >= 1.2 and < 1.3 (but for major version numbers)\n  if (trimmed.startsWith(\"~\")) {\n    const versionStr = trimmed.substring(1);\n    const [major, minor] = versionStr.split(\".\").map(Number);\n    if (minor === undefined) {\n      // ~1 is equivalent to ^1\n      return providedVersion >= major && providedVersion < major + 1;\n    }\n    // For ~1.2, since we're dealing with major version numbers, only match the major\n    return providedVersion === major;\n  }\n\n  // Greater than or equal: >=1\n  if (trimmed.startsWith(\">=\")) {\n    const version = parseInt(trimmed.substring(2), 10);\n    return providedVersion >= version;\n  }\n\n  // Greater than: >1\n  if (trimmed.startsWith(\">\")) {\n    const version = parseInt(trimmed.substring(1), 10);\n    return providedVersion > version;\n  }\n\n  // Less than or equal: <=1\n  if (trimmed.startsWith(\"<=\")) {\n    const version = parseInt(trimmed.substring(2), 10);\n    return providedVersion <= version;\n  }\n\n  // Less than: <1\n  if (trimmed.startsWith(\"<\")) {\n    const version = parseInt(trimmed.substring(1), 10);\n    return providedVersion < version;\n  }\n\n  // Exact version: 1\n  const version = parseInt(trimmed, 10);\n  if (!Number.isNaN(version)) {\n    return providedVersion === version;\n  }\n\n  return false;\n}\n\n/**\n * The capability version a provider offers for a requirement: among the provider's versions of the required\n * capability that satisfy the requirement's version constraint, the highest. A provider may serve several versions of\n * one capability name; every one of them is considered, never only the first declared.\n */\nfunction satisfyingCapability(\n  requirement: RequirementWithConstraints,\n  provider: ApplicationState\n): CapabilityManifestEntry | undefined {\n  const versionConstraint = requirement.versionConstraint || String(requirement.version);\n  let selected: CapabilityManifestEntry | undefined;\n  for (const capability of provider.manifest.provides) {\n    if (capability.name !== requirement.name) continue;\n    if (!satisfiesVersionConstraint(capability.version, versionConstraint)) continue;\n    if (!selected || capability.version > selected.version) selected = capability;\n  }\n  return selected;\n}\n\n/**\n * Evaluate capability compatibility between a provider and a requirement.\n *\n * Checks:\n * - Capability name matches exactly\n * - Some provided version satisfies version constraint\n * - Provider passes provider constraint (if specified)\n *\n * Returns a CompatibilityResult with detailed reasons.\n */\nexport function evaluateCompatibility(\n  requirement: RequirementWithConstraints,\n  provider: ApplicationState\n): CompatibilityResult {\n  const reasons: string[] = [];\n\n  // A canonical requirement names a business capability, not an application capability.\n  // A provider capability with the same name is not evidence of fulfilling it.\n  if (requirement.canonical) {\n    reasons.push(`\"${requirement.name}\" is a capability of canonical contract \"${requirement.canonical.contract}\"; it resolves only through fulfillment claims`);\n    return { compatible: false, reasons };\n  }\n\n  // Find every version of the capability in the provider's manifest\n  const versions = provider.manifest.provides\n    .filter((cap) => cap.name === requirement.name)\n    .map((cap) => cap.version)\n    .sort((a, b) => a - b);\n\n  if (versions.length === 0) {\n    reasons.push(`Provider ${provider.id} does not provide capability \"${requirement.name}\"`);\n    return { compatible: false, reasons };\n  }\n\n  // Check version constraint against every provided version\n  const versionConstraint = requirement.versionConstraint || String(requirement.version);\n  if (!satisfyingCapability(requirement, provider)) {\n    reasons.push(\n      versions.length === 1\n        ? `Provider version ${versions[0]} does not satisfy constraint \"${versionConstraint}\" for \"${requirement.name}\"`\n        : `Provider versions ${versions.join(\", \")} do not satisfy constraint \"${versionConstraint}\" for \"${requirement.name}\"`\n    );\n    return { compatible: false, reasons };\n  }\n\n  // Check provider constraint\n  if (requirement.provider?.applicationId) {\n    if (provider.id !== requirement.provider.applicationId) {\n      reasons.push(\n        `Requirement specifies provider \"${requirement.provider.applicationId}\" but got provider \"${provider.id}\"`\n      );\n      return { compatible: false, reasons };\n    }\n  }\n\n  // All checks passed\n  return { compatible: true, reasons: [] };\n}\n\n/**\n * Application Dependency Resolver\n *\n * Resolves application requirements against the Application Registry using\n * deterministic compatibility evaluation and provider selection.\n */\nexport class ApplicationDependencyResolver {\n  readonly #registry: ApplicationRegistry;\n  readonly #contracts: CanonicalContractRegistry | undefined;\n  readonly #authorityDecisions: readonly AuthorityEquivalence[];\n\n  constructor(registry: ApplicationRegistry, options: ResolverOptions = {}) {\n    this.#registry = registry;\n    this.#contracts = options.contracts;\n    this.#authorityDecisions = options.authorityDecisions ?? [];\n  }\n\n  /**\n   * Resolve a single requirement against the registry.\n   *\n   * Flow:\n   * 1. Discover candidate providers (findByCapability)\n   * 2. Evaluate compatibility for each candidate\n   * 3. Apply provider constraints\n   * 4. Select deterministically or report ambiguity\n   * 5. Return ResolvedRequirement, UnresolvedRequirement, or AmbiguousRequirement\n   */\n  async resolveRequirement(requirement: RequirementWithConstraints): Promise<ResolutionResult> {\n    // Canonical requirements have their own path and never fall back to name matching.\n    if (requirement.canonical) return this.#resolveCanonical(requirement);\n\n    // If requirement has a provider constraint, look for that specific provider\n    if (requirement.provider?.applicationId) {\n      const provider = await this.#registry.get(requirement.provider.applicationId);\n      if (!provider) {\n        return {\n          kind: \"unresolved\",\n          requirement,\n          candidates: [],\n          reason: `Provider \"${requirement.provider.applicationId}\" not found in registry`\n        };\n      }\n      if (provider.status === \"retired\") {\n        return {\n          kind: \"unresolved\",\n          requirement,\n          candidates: [provider],\n          reason: `Provider \"${provider.id}\" is retired`\n        };\n      }\n\n      const compat = evaluateCompatibility(requirement, provider);\n      if (compat.compatible) {\n        const capability = satisfyingCapability(requirement, provider)!;\n        const resolution: ResolvedRequirement = {\n          kind: \"resolved\",\n          requirement,\n          provider,\n          capability,\n          compatibility: compat\n        };\n        attestResolution(resolution, this.#registry);\n        return resolution;\n      } else {\n        return {\n          kind: \"unresolved\",\n          requirement,\n          candidates: [provider],\n          reason: compat.reasons.join(\"; \")\n        };\n      }\n    }\n\n    // Discover candidates: applications providing this capability\n    const candidates = await this.#registry.findByCapability(requirement.name);\n\n    if (candidates.length === 0) {\n      return {\n        kind: \"unresolved\",\n        requirement,\n        candidates: [],\n        reason: `No providers found for capability \"${requirement.name}\"`\n      };\n    }\n\n    // Evaluate compatibility for each candidate\n    const compatible: Array<{ provider: ApplicationState; capability: CapabilityManifestEntry }> = [];\n\n    for (const candidate of candidates) {\n      const compat = evaluateCompatibility(requirement, candidate);\n      if (compat.compatible) {\n        const capability = satisfyingCapability(requirement, candidate)!;\n        compatible.push({ provider: candidate, capability });\n      }\n    }\n\n    if (compatible.length === 0) {\n      return {\n        kind: \"unresolved\",\n        requirement,\n        candidates,\n        reason: `No compatible providers found for \"${requirement.name}\"`\n      };\n    }\n\n    // Lifecycle eligibility, after compatibility: a promoted provider excludes registered-only ones.\n    const active = compatible.filter((entry) => entry.provider.status === \"active\");\n    if (active.length > 0) compatible.splice(0, compatible.length, ...active);\n\n    if (compatible.length > 1) {\n      // Apply deterministic selection: highest version, then by application ID\n      compatible.sort((a, b) => {\n        const versionDiff = b.capability.version - a.capability.version;\n        if (versionDiff !== 0) return versionDiff;\n        return a.provider.id.localeCompare(b.provider.id);\n      });\n\n      // Check if the top candidate is unique\n      const top = compatible[0];\n      const second = compatible[1];\n      if (\n        top.capability.version === second.capability.version &&\n        top.provider.id !== second.provider.id\n      ) {\n        // Ambiguous: multiple providers with same version\n        return {\n          kind: \"ambiguous\",\n          requirement,\n          candidates: compatible.map((c) => c.provider)\n        };\n      }\n    }\n\n    // Return the selected provider\n    const selected = compatible[0];\n    const resolution: ResolvedRequirement = {\n      kind: \"resolved\",\n      requirement,\n      provider: selected.provider,\n      capability: selected.capability,\n      compatibility: { compatible: true, reasons: [] }\n    };\n    attestResolution(resolution, this.#registry);\n    return resolution;\n  }\n\n  /**\n   * Discover providers of a canonical capability.\n   *\n   * Flow:\n   * 1. The canonical contract must be registered and active, and define a version satisfying the constraint\n   * 2. Candidates are registered, non-retired applications whose capabilities *claim* that canonical capability\n   * 3. Every claim is evaluated with `evaluateFulfillment` against the contract's current revision\n   *\n   * Nothing is cached: each call reads the authoritative registries, so a revised contract, a re-registered provider\n   * or a changed claim is always evaluated as it is now. No step consults a provider capability's name.\n   */\n  async discoverCanonical(query: CanonicalDiscoveryQuery): Promise<CanonicalDiscovery> {\n    const { contract: contractId, capability: name, versionConstraint: constraint } = query;\n    if (!this.#contracts) {\n      return { kind: \"unavailable\", reason: `\"${name}\" is a capability of canonical contract \"${contractId}\", and this resolver has no canonical contract registry` };\n    }\n    const contract = await this.#contracts.get(contractId);\n    if (!contract) return { kind: \"unavailable\", reason: `Canonical contract \"${contractId}\" is not registered` };\n    if (contract.status !== \"active\") return { kind: \"unavailable\", reason: `Canonical contract \"${contractId}\" is ${contract.status}, not active` };\n    const versions = (contract.manifest.capabilities.find((entry) => entry.name === name)?.definitions ?? [])\n      .map((definition) => definition.version)\n      .filter((version) => satisfiesVersionConstraint(version, constraint));\n    if (versions.length === 0) {\n      return { kind: \"unavailable\", reason: `Canonical contract \"${contractId}\" defines no version of \"${name}\" satisfying \"${constraint}\"` };\n    }\n\n    const applications = (await this.#registry.list()).filter(\n      (application) => application.status !== \"retired\" && (!query.provider || application.id === query.provider)\n    );\n    const candidates: CanonicalCandidate[] = [];\n    for (const application of applications) {\n      const published = toProtocolManifest(application.manifest);\n      for (const version of versions) {\n        const required = findCapabilityVersion(contract.manifest, name, version)?.authorization ?? [];\n        for (const { capability, claim } of claimsFor(published, { contract: contractId, capability: name, version })) {\n          const entry = application.manifest.provides.find((item) => item.name === capability.name && item.version === capability.version);\n          if (!entry) continue;\n          const evaluation = evaluateFulfillment({\n            canonical: contract.manifest,\n            provider: published,\n            capability,\n            claim,\n            authorityDecisions: this.#authorityDecisions\n          });\n          const evidence: CanonicalResolutionEvidence = {\n            contract: { id: contract.id, revision: contract.revision, digest: contract.digest },\n            capability: { name, version, digest: evaluation.canonical.currentDigest ?? claim.digest },\n            provider: {\n              application: application.id,\n              registrationId: application.registrationId,\n              fingerprint: application.fingerprint,\n              revision: application.revision,\n              capability: { name: entry.name, version: entry.version }\n            },\n            claim: structuredClone(claim),\n            status: evaluation.status,\n            compatible: evaluation.compatibility.compatible,\n            authority: {\n              required: [...required],\n              enforced: [...entry.authorization],\n              ...(claim.authority ? { mapping: structuredClone(claim.authority) } : {})\n            }\n          };\n          candidates.push({ provider: application, capability: entry, evaluation, evidence, eligible: evaluation.status === \"valid\" });\n        }\n      }\n    }\n    return {\n      kind: \"discovered\",\n      contract: { id: contract.id, revision: contract.revision, digest: contract.digest, status: contract.status },\n      versions,\n      candidates,\n      eligible: candidates.filter((candidate) => candidate.eligible)\n    };\n  }\n\n  /**\n   * Resolve a requirement on a canonical capability, from {@link discoverCanonical}.\n   *\n   * 1. Only `valid` claims are eligible; stale, unverified, invalid or absent claims leave the requirement unresolved,\n   *    with every evaluation attached so the reason is inspectable\n   * 2. Lifecycle eligibility as for name-based resolution: an active provider excludes registered-only ones\n   * 3. The highest canonical version wins; two providers at that version are ambiguous, never picked arbitrarily\n   *\n   * The resolution carries {@link CanonicalResolutionEvidence} and is attested against both the provider registration\n   * and the canonical capability revision.\n   */\n  async #resolveCanonical(requirement: RequirementWithConstraints): Promise<ResolutionResult> {\n    const contractId = requirement.canonical!.contract;\n    const constraint = requirement.versionConstraint || String(requirement.version);\n    const unresolved = (reason: string, candidates: readonly ApplicationState[] = [], evaluations: readonly FulfillmentEvaluation[] = []): UnresolvedRequirement => ({\n      kind: \"unresolved\",\n      requirement,\n      candidates,\n      reason,\n      ...(evaluations.length ? { evaluations } : {})\n    });\n\n    const discovery = await this.discoverCanonical({\n      contract: contractId,\n      capability: requirement.name,\n      versionConstraint: constraint,\n      ...(requirement.provider?.applicationId ? { provider: requirement.provider.applicationId } : {})\n    });\n    if (discovery.kind === \"unavailable\") return unresolved(discovery.reason);\n\n    const evaluated = discovery.candidates;\n    const claimants = [...new Map(evaluated.map((entry) => [entry.provider.id, entry.provider])).values()];\n    const evaluations = evaluated.map((entry) => entry.evaluation);\n    if (evaluated.length === 0) {\n      return unresolved(`No registered provider claims ${requirement.name}@${constraint} of canonical contract \"${contractId}\"`);\n    }\n\n    let eligible = [...discovery.eligible];\n    if (eligible.length === 0) {\n      const summary = evaluated\n        .map((entry) => `${entry.provider.id}:${entry.capability.name}@${entry.capability.version} is ${entry.evaluation.status}`)\n        .join(\"; \");\n      return unresolved(`No valid fulfillment of ${requirement.name}@${constraint} of canonical contract \"${contractId}\" (${summary})`, claimants, evaluations);\n    }\n\n    const active = eligible.filter((entry) => entry.provider.status === \"active\");\n    if (active.length > 0) eligible = active;\n\n    const topVersion = Math.max(...eligible.map((entry) => entry.evaluation.canonical.version));\n    const top = eligible\n      .filter((entry) => entry.evaluation.canonical.version === topVersion)\n      .sort((a, b) => a.provider.id.localeCompare(b.provider.id) || a.capability.name.localeCompare(b.capability.name) || b.capability.version - a.capability.version);\n    const distinct = new Set(top.map((entry) => `${entry.provider.id}|${entry.capability.name}`));\n    if (distinct.size > 1) {\n      return {\n        kind: \"ambiguous\",\n        requirement,\n        candidates: [...new Map(top.map((entry) => [entry.provider.id, entry.provider])).values()],\n        evaluations: top.map((entry) => entry.evaluation)\n      };\n    }\n\n    const selected = top[0]!;\n    const resolution: ResolvedRequirement = {\n      kind: \"resolved\",\n      requirement,\n      provider: selected.provider,\n      capability: selected.capability,\n      compatibility: { compatible: true, reasons: [] },\n      fulfillment: selected.evaluation,\n      canonical: selected.evidence\n    };\n    attestResolution(resolution, this.#registry, { contracts: this.#contracts!, evidence: selected.evidence });\n    return resolution;\n  }\n\n  /**\n   * Resolve all requirements of an application.\n   *\n   * Returns a comprehensive ApplicationResolution containing:\n   * - All resolution results\n   * - Separated resolved/unresolved/ambiguous for easy access\n   * - The application state (unchanged)\n   */\n  async resolveApplication(application: ApplicationState): Promise<ApplicationResolution> {\n    const results: ResolutionResult[] = [];\n\n    for (const requirement of application.manifest.requires) {\n      const requirementWithConstraints: RequirementWithConstraints = {\n        ...requirement,\n        versionConstraint: requirement.versionConstraint || String(requirement.version)\n      };\n      const result = await this.resolve