index 0000000..47119b2
--- /dev/null
+++ b/crates/compute-provider/tests/target_credentials.rs
@@ -0,0 +1,79 @@
+//! A `compute serve` target's credential contract, through the real HTTP
+//! path: only the credentials in its trust file are admitted, and a
+//! credential revoked in that file is refused at the next request, on every
+//! endpoint, health and jobs included.
+
+use std::sync::Arc;
+
+use compute_provider::{
+    ComputeProvider, ProviderErrorKind, RemoteProvider, ServerConfig, TargetAuthorizer,
+    TargetCredentials,
+};
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn a_revoked_credential_is_refused_even_when_the_trust_file_keeps_its_timestamp() {
+    let directory = tempfile::tempdir().unwrap();
+    let trust = directory.path().join("target-credentials.json");
+    let mut credentials = TargetCredentials::default();
+    let (record, token) = credentials.issue("control-plane-a").unwrap();
+    let (_, other) = credentials.issue("control-plane-b").unwrap();
+    credentials.save(&trust).unwrap();
+    let modified = std::fs::metadata(&trust).unwrap().modified().unwrap();
+
+    let jobs = directory.path().join("jobs");
+    std::fs::create_dir_all(&jobs).unwrap();
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let endpoint = format!("http://{}", listener.local_addr().unwrap());
+    let mut config = ServerConfig::local(endpoint.clone());
+    config.authorizer = Arc::new(TargetAuthorizer::from_file(&trust));
+    config.job_store = jobs;
+    config.session_store = directory.path().join("sessions");
+    let server = tokio::spawn(async move {
+        let _ = compute_provider::serve_listener(listener, config).await;
+    });
+
+    // Missing, malformed and wrong credentials are refused, health included.
+    for client in [
+        RemoteProvider::new(endpoint.clone()),
+        RemoteProvider::new(endpoint.clone()).with_bearer_token("not-a-token"),
+        RemoteProvider::new(endpoint.clone()).with_bearer_token("cmpt_tcred_0000000000000000_00"),
+    ] {
+        assert_eq!(
+            client.health().await.unwrap_err().kind,
+            ProviderErrorKind::Unauthorized
+        );
+        assert_eq!(
+            client.jobs().await.unwrap_err().kind,
+            ProviderErrorKind::Unauthorized
+        );
+    }
+
+    // A valid credential works.
+    let client = RemoteProvider::new(endpoint.clone()).with_bearer_token(token.clone());
+    let survivor = RemoteProvider::new(endpoint.clone()).with_bearer_token(other.clone());
+    assert!(client.health().await.unwrap().healthy);
+    assert!(client.jobs().await.unwrap().is_empty());
+
+    // Revoke it on disk; the rewritten file keeps the timestamp it had, as
+    // a coarse-resolution filesystem or a quick rewrite leaves it.
+    credentials.revoke(&record.credential_id).unwrap();
+    credentials.save(&trust).unwrap();
+    std::fs::File::options()
+        .append(true)
+        .open(&trust)
+        .unwrap()
+        .set_modified(modified)
+        .unwrap();
+    assert_eq!(std::fs::metadata(&trust).unwrap().modified().unwrap(), modified);
+
+    let refused = client.health().await.unwrap_err();
+    assert_eq!(refused.kind, ProviderErrorKind::Unauthorized, "{refused:?}");
+    assert!(refused.message.contains("revoked"), "{refused:?}");
+    assert_eq!(
+        client.jobs().await.unwrap_err().kind,
+        ProviderErrorKind::Unauthorized
+    );
+    // Another credential the file still trusts keeps working.
+    assert!(survivor.health().await.unwrap().healthy);
+    server.abort();
+}
