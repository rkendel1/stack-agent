I found what looks like a revocation bypass: the trust-file cache is keyed only on the file's mtime. I'm adding HTTP regression tests that should fail on the starting commit, before changing any code.

{"decision":"request_capability","capability":"project.write","inputs":{"path":"crates/compute-provider/tests/target_authorization.rs","expect_absent":true,"content":"//! A `compute serve` target's credential contract, through the real HTTP\n//! path: every protected endpoint refuses missing, malformed, wrong and\n//! revoked credentials, and a revocation ends access at the next request.\n\nuse std::path::Path;\nuse std::sync::Arc;\nuse std::time::SystemTime;\n\nuse compute_provider::{\n    ComputeProvider, ProviderErrorKind, RemoteProvider, ServerConfig, TargetAuthorizer,\n    TargetCredentials,\n};\n\nstruct Target {\n    endpoint: String,\n    server: tokio::task::JoinHandle<()>,\n    _stores: tempfile::TempDir,\n}\n\nimpl Drop for Target {\n    fn drop(&mut self) {\n        self.server.abort();\n    }\n}\n\nasync fn start(trust: &Path) -> Target {\n    let stores = tempfile::tempdir().unwrap();\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n    let endpoint = format!(\"http://{}\", listener.local_addr().unwrap());\n    let mut config = ServerConfig::local(endpoint.clone());\n    config.authorizer = Arc::new(TargetAuthorizer::from_file(trust.to_path_buf()));\n    config.job_store = stores.path().join(\"jobs\");\n    config.session_store = stores.path().join(\"sessions\");\n    let server = tokio::spawn(async move {\n        let _ = compute_provider::serve_listener(listener, config).await;\n    });\n    Target {\n        endpoint,\n        server,\n        _stores: stores,\n    }\n}\n\nfn modified(path: &Path) -> SystemTime {\n    std::fs::metadata(path).unwrap().modified().unwrap()\n}\n\n/// Give a rewritten trust file a timestamp it already had, as a filesystem\n/// with coarse timestamps (or two writes within one clock tick) does.\nfn keep_timestamp(path: &Path, at: SystemTime) {\n    let file = std::fs::File::options().append(true).open(path).unwrap();\n    file.set_modified(at).unwrap();\n}\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\nasync fn a_revocation_ends_access_even_when_the_trust_file_keeps_its_timestamp() {\n    let directory = tempfile::tempdir().unwrap();\n    let trust = directory.path().join(\"target-credentials.json\");\n    let mut credentials = TargetCredentials::default();\n    let (first, token) = credentials.issue(\"cp-a\").unwrap();\n    let (second, rotated) = credentials.issue(\"cp-a\").unwrap();\n    credentials.save(&trust).unwrap();\n    let at = modified(&trust);\n    let target = start(&trust).await;\n    let client = RemoteProvider::new(target.endpoint.clone()).with_bearer_token(token.clone());\n    let replacement = RemoteProvider::new(target.endpoint.clone()).with_bearer_token(rotated.clone());\n    assert!(client.health().await.unwrap().healthy);\n    assert!(replacement.health().await.unwrap().healthy);\n\n    // Revoked: refused at the next request, on every endpoint.\n    credentials.revoke(&first.credential_id).unwrap();\n    credentials.save(&trust).unwrap();\n    keep_timestamp(&trust, at);\n    let refused = client.health().await.unwrap_err();\n    assert_eq!(refused.kind, ProviderErrorKind::Unauthorized, \"{refused:?}\");\n    assert!(refused.message.contains(\"revoked\"), \"{refused:?}\");\n    assert_eq!(\n        client.capabilities().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    assert_eq!(\n        client.jobs().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    // The rotated credential for the same control plane still works.\n    assert!(replacement.health().await.unwrap().healthy);\n\n    // Removed from the file entirely: refused too.\n    credentials\n        .credentials\n        .retain(|record| record.credential_id != second.credential_id);\n    credentials.save(&trust).unwrap();\n    keep_timestamp(&trust, at);\n    assert_eq!(\n        replacement.health().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n}\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\nasync fn unauthenticated_callers_learn_nothing_from_any_endpoint() {\n    let directory = tempfile::tempdir().unwrap();\n    let trust = directory.path().join(\"target-credentials.json\");\n    let mut credentials = TargetCredentials::default();\n    let (_, token) = credentials.issue(\"cp-a\").unwrap();\n    credentials.save(&trust).unwrap();\n    let target = start(&trust).await;\n    let endpoint = target.endpoint.clone();\n    let last = if token.ends_with('0') { '1' } else { '0' };\n    let forged = format!(\"{}{last}\", &token[..token.len() - 1]);\n    let callers = [\n        RemoteProvider::new(endpoint.clone()),\n        RemoteProvider::new(endpoint.clone()).with_bearer_token(\"not-a-token\"),\n        RemoteProvider::new(endpoint.clone()).with_bearer_token(\"cmpt_tcred_0000000000000000_00\"),\n        RemoteProvider::new(endpoint.clone()).with_bearer_token(forged),\n    ];\n    for caller in &callers {\n        for error in [\n            caller.health().await.unwrap_err(),\n            caller.capabilities().await.unwrap_err(),\n            caller.jobs().await.unwrap_err(),\n            // This target does not offer sessions; an unauthenticated\n            // caller must not be able to find that out.\n            caller.sessions().await.unwrap_err(),\n        ] {\n            assert_eq!(error.kind, ProviderErrorKind::Unauthorized, \"{error:?}\");\n        }\n    }\n    // The valid credential works, and sees the real answer.\n    let valid = RemoteProvider::new(endpoint).with_bearer_token(token);\n    assert!(valid.health().await.unwrap().healthy);\n    assert!(valid.jobs().await.unwrap().is_empty());\n    assert_eq!(\n        valid.sessions().await.unwrap_err().kind,\n        ProviderErrorKind::CapabilityMismatch\n    );\n}\n"}}
