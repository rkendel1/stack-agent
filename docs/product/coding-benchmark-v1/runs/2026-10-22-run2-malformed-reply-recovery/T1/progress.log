Model reply:
Reading the code points to a revocation defect. `TargetAuthorizer::from_file` keeps a cached copy of the trust file and only re-reads it when the file's modification time changes. If the file is rewritten within the same timestamp, the server keeps using stale credentials. That breaks the documented promise that revocation "ends its access at the next request". To reproduce this before changing any code, I am adding a test that goes through the real HTTP server and pins the trust file's timestamp after a revocation.

{"decision":"request_capability","capability":"project.write","inputs":{"path":"crates/compute-provider/tests/target_authorization.rs","expect_absent":true,"content":"//! A `compute serve` target's credential contract, through the real HTTP\n//! path: revocation and removal take effect at the next request, whatever\n//! the trust file's timestamp says.\n\nuse std::sync::Arc;\n\nuse compute_provider::{\n    ProviderErrorKind, RemoteProvider, ServerConfig, TargetAuthorizer, TargetCredentials,\n};\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\nasync fn revocation_takes_effect_even_when_the_trust_file_keeps_its_timestamp() {\n    let directory = tempfile::tempdir().unwrap();\n    let jobs = tempfile::tempdir().unwrap();\n    let trust = directory.path().join(\"target-credentials.json\");\n    let mut credentials = TargetCredentials::default();\n    let (revoked_record, revoked_token) = credentials.issue(\"control-plane-a\").unwrap();\n    let (_, kept_token) = credentials.issue(\"control-plane-a\").unwrap();\n    let (_, removed_token) = credentials.issue(\"control-plane-b\").unwrap();\n    credentials.save(&trust).unwrap();\n    let modified = std::fs::metadata(&trust).unwrap().modified().unwrap();\n\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n    let endpoint = format!(\"http://{}\", listener.local_addr().unwrap());\n    let mut config = ServerConfig::local(endpoint.clone());\n    config.authorizer = Arc::new(TargetAuthorizer::from_file(&trust));\n    config.job_store = jobs.path().to_path_buf();\n    let server = tokio::spawn(async move {\n        let _ = compute_provider::serve_listener(listener, config).await;\n    });\n\n    let anonymous = RemoteProvider::new(endpoint.clone());\n    let malformed = RemoteProvider::new(endpoint.clone()).with_bearer_token(\"nope\");\n    let revoked = RemoteProvider::new(endpoint.clone()).with_bearer_token(revoked_token.as_str());\n    let kept = RemoteProvider::new(endpoint.clone()).with_bearer_token(kept_token.as_str());\n    let removed = RemoteProvider::new(endpoint.clone()).with_bearer_token(removed_token.as_str());\n\n    // Missing and malformed credentials are refused, health included.\n    assert_eq!(\n        anonymous.health().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    assert_eq!(\n        malformed.health().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    // Every issued credential works while the target trusts it.\n    revoked.health().await.unwrap();\n    kept.health().await.unwrap();\n    removed.health().await.unwrap();\n\n    // Revoke one credential and remove another, then give the trust file\n    // back the timestamp it had (a rewrite within one timestamp tick).\n    credentials\n        .revoke(&revoked_record.credential_id)\n        .unwrap();\n    credentials\n        .credentials\n        .retain(|record| record.control_plane != \"control-plane-b\");\n    credentials.save(&trust).unwrap();\n    std::fs::File::options()\n        .append(true)\n        .open(&trust)\n        .unwrap()\n        .set_modified(modified)\n        .unwrap();\n\n    let error = revoked.health().await.unwrap_err();\n    assert_eq!(error.kind, ProviderErrorKind::Unauthorized, \"{error:?}\");\n    assert!(error.message.contains(\"revoked\"), \"{error:?}\");\n    assert_eq!(\n        revoked.sessions().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    assert_eq!(\n        removed.health().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    // The rotated credential of the same control plane keeps working.\n    kept.health().await.unwrap();\n    server.abort();\n}\n"}}
