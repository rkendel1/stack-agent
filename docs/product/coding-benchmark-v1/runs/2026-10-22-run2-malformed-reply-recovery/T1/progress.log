{"decision":"request_capability","capability":"project.write","inputs":{"path":"crates/compute-provider/tests/target_credentials.rs","expect_absent":true,"content":"//! A `compute serve` target's credential contract, through the real HTTP\n//! path: only the credentials in its trust file are admitted, and a\n//! credential revoked in that file is refused at the next request, on every\n//! endpoint, health and jobs included.\n\nuse std::sync::Arc;\n\nuse compute_provider::{\n    ComputeProvider, ProviderErrorKind, RemoteProvider, ServerConfig, TargetAuthorizer,\n    TargetCredentials,\n};\n\n#[tokio::test(flavor = \"multi_thread\", worker_threads = 2)]\nasync fn a_revoked_credential_is_refused_even_when_the_trust_file_keeps_its_timestamp() {\n    let directory = tempfile::tempdir().unwrap();\n    let trust = directory.path().join(\"target-credentials.json\");\n    let mut credentials = TargetCredentials::default();\n    let (record, token) = credentials.issue(\"control-plane-a\").unwrap();\n    let (_, other) = credentials.issue(\"control-plane-b\").unwrap();\n    credentials.save(&trust).unwrap();\n    let modified = std::fs::metadata(&trust).unwrap().modified().unwrap();\n\n    let jobs = directory.path().join(\"jobs\");\n    std::fs::create_dir_all(&jobs).unwrap();\n    let listener = tokio::net::TcpListener::bind(\"127.0.0.1:0\").await.unwrap();\n    let endpoint = format!(\"http://{}\", listener.local_addr().unwrap());\n    let mut config = ServerConfig::local(endpoint.clone());\n    config.authorizer = Arc::new(TargetAuthorizer::from_file(&trust));\n    config.job_store = jobs;\n    config.session_store = directory.path().join(\"sessions\");\n    let server = tokio::spawn(async move {\n        let _ = compute_provider::serve_listener(listener, config).await;\n    });\n\n    // Missing, malformed and wrong credentials are refused, health included.\n    for client in [\n        RemoteProvider::new(endpoint.clone()),\n        RemoteProvider::new(endpoint.clone()).with_bearer_token(\"not-a-token\"),\n        RemoteProvider::new(endpoint.clone()).with_bearer_token(\"cmpt_tcred_0000000000000000_00\"),\n    ] {\n        assert_eq!(\n            client.health().await.unwrap_err().kind,\n            ProviderErrorKind::Unauthorized\n        );\n        assert_eq!(\n            client.jobs().await.unwrap_err().kind,\n            ProviderErrorKind::Unauthorized\n        );\n    }\n\n    // A valid credential works.\n    let client = RemoteProvider::new(endpoint.clone()).with_bearer_token(token.clone());\n    let survivor = RemoteProvider::new(endpoint.clone()).with_bearer_token(other.clone());\n    assert!(client.health().await.unwrap().healthy);\n    assert!(client.jobs().await.unwrap().is_empty());\n\n    // Revoke it on disk; the rewritten file keeps the timestamp it had, as\n    // a coarse-resolution filesystem or a quick rewrite leaves it.\n    credentials.revoke(&record.credential_id).unwrap();\n    credentials.save(&trust).unwrap();\n    std::fs::File::options()\n        .append(true)\n        .open(&trust)\n        .unwrap()\n        .set_modified(modified)\n        .unwrap();\n    assert_eq!(std::fs::metadata(&trust).unwrap().modified().unwrap(), modified);\n\n    let refused = client.health().await.unwrap_err();\n    assert_eq!(refused.kind, ProviderErrorKind::Unauthorized, \"{refused:?}\");\n    assert!(refused.message.contains(\"revoked\"), \"{refused:?}\");\n    assert_eq!(\n        client.jobs().await.unwrap_err().kind,\n        ProviderErrorKind::Unauthorized\n    );\n    // Another credential the file still trusts keeps working.\n    assert!(survivor.health().await.unwrap().healthy);\n    server.abort();\n}\n"}}
