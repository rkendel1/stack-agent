+/// Intersect two version restrictions for one runtime under the rule
+/// admission applies: a version is allowed when it contains one of the
+/// listed entries. Version entries are patterns, not opaque values, so
+/// they cannot be intersected by equality: `3` and `3.13` share no entry
+/// yet both admit `3.13.1`.
+///
+/// For every pair, the more specific entry (the one that contains the
+/// other) is kept: any version containing it also contains the less
+/// specific one, so it satisfies both sides. A pair where neither entry
+/// contains the other is dropped. The result therefore never admits a
+/// version either side denies, and it is independent of argument order.
+fn intersect_version_prefixes(left: &[String], right: &[String]) -> Vec<String> {
+    let mut merged = BTreeSet::new();
+    for left in left {
+        for right in right {
+            if left.contains(right.as_str()) {
+                merged.insert(left.clone());
+            } else if right.contains(left.as_str()) {
+                merged.insert(right.clone());
+            }
+        }
+    }
+    merged.into_iter().collect()
+}
