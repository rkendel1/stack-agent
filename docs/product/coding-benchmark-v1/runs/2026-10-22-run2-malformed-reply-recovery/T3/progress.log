{"decision":"request_capability","capability":"project.write","inputs":{"path":"crates/compute-policy/tests/runtime_versions.rs","expect_absent":true,"content":"//! Composition of `allowed_runtime_versions` across policy sources.\n//!\n//! Sources may restrict a runtime's version at different levels of detail\n//! (\"3\" and \"3.13\"). The effective policy must admit a version exactly when\n//! every source admits it, whatever the order of composition.\n\nuse std::collections::BTreeMap;\n\nuse compute_core::{\n    IsolationRequirement, NetworkPolicy, PlatformIdentity, ProviderIdentity, ResourceLimits,\n    RuntimeKind, WORKLOAD_SPEC_VERSION, WorkloadBundle, WorkloadSpec,\n};\nuse compute_policy::*;\n\nfn contract() -> ExecutionContract {\n    let root = tempfile::tempdir().unwrap();\n    std::fs::write(root.path().join(\"main.py\"), \"print('hello')\\n\").unwrap();\n    let workload = WorkloadSpec {\n        version: WORKLOAD_SPEC_VERSION.into(),\n        runtime: RuntimeKind::Python,\n        runtime_version: None,\n        architecture: None,\n        entrypoint: \"main.py\".into(),\n        args: vec![],\n        env: BTreeMap::new(),\n        inputs: vec![],\n        outputs: vec![],\n        resources: ResourceLimits::default(),\n        network: NetworkPolicy::None,\n        isolation: IsolationRequirement::default(),\n        dependencies: None,\n    };\n    let bundle = WorkloadBundle::create_from(workload, root.path()).unwrap();\n    ExecutionContract::from_bundle(&bundle, None).unwrap()\n}\n\nfn provider(version: &str) -> ProviderFacts {\n    ProviderFacts {\n        identity: ProviderIdentity::Local { id: \"local\".into() },\n        distribution_id: None,\n        platform: Some(PlatformIdentity {\n            os: \"linux\".into(),\n            architecture: \"x86_64\".into(),\n            runtime_abi: None,\n        }),\n        runtime_version: Some(version.into()),\n    }\n}\n\nfn policy(json: serde_json::Value) -> Policy {\n    Policy::from_json(json.to_string().as_bytes()).unwrap()\n}\n\nfn decide(policy: &Policy, version: &str) -> AdmissionDecision {\n    admit(\n        policy,\n        &contract(),\n        &provider(version),\n        &CapabilityStatus::Compatible,\n    )\n}\n\nfn admits(policy: &Policy, version: &str) -> bool {\n    decide(policy, version).admitted\n}\n\nfn both_orders(left: &Policy, right: &Policy) -> Policy {\n    let forward = EffectivePolicy::compose(&[\n        (PolicySourceKind::Server, left.clone()),\n        (PolicySourceKind::Explicit, right.clone()),\n    ]);\n    let backward = EffectivePolicy::compose(&[\n        (PolicySourceKind::Server, right.clone()),\n        (PolicySourceKind::Explicit, left.clone()),\n    ]);\n    assert_eq!(\n        forward.policy, backward.policy,\n        \"composition order must not matter\"\n    );\n    assert_eq!(forward.policy_id, backward.policy_id);\n    assert_eq!(left.intersect(right), right.intersect(left));\n    forward.policy\n}\n\nconst VERSIONS: [&str; 7] = [\n    \"3.13.1\", \"3.13.0\", \"3.12.4\", \"3.10.2\", \"3.1.5\", \"2.7.18\", \"4.0.0\",\n];\n\n/// The combination admits a version exactly when every source admits it.\nfn assert_exact_intersection(left: &Policy, right: &Policy) {\n    let combined = both_orders(left, right);\n    for version in VERSIONS {\n        let expected = admits(left, version) && admits(right, version);\n        assert_eq!(\n            admits(&combined, version),\n            expected,\n            \"version {version}: left={:?} right={:?} combined={:?}\",\n            left.allowed_runtime_versions,\n            right.allowed_runtime_versions,\n            combined.allowed_runtime_versions\n        );\n    }\n}\n\n#[test]\nfn coarse_and_fine_version_restrictions_compose() {\n    let server = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3\"]}}));\n    let caller =\n        policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.13\"]}}));\n    assert!(admits(&server, \"3.13.1\"));\n    assert!(admits(&caller, \"3.13.1\"));\n\n    let combined = both_orders(&server, &caller);\n    let decision = decide(&combined, \"3.13.1\");\n    assert!(decision.admitted, \"{:?}\", decision.reasons);\n\n    // A version one source denies stays denied, naming the allowed versions.\n    let older = decide(&combined, \"3.12.4\");\n    assert_eq!(older.codes(), [\"runtime_version_denied\"]);\n    assert_eq!(older.reasons[0].allowed, serde_json::json!([\"3.13\"]));\n    assert!(!admits(&combined, \"2.7.18\"));\n    assert_exact_intersection(&server, &caller);\n\n    // Adding a further source with `with` behaves the same way.\n    let staged = EffectivePolicy::compose(&[(PolicySourceKind::Server, server.clone())])\n        .with(PolicySourceKind::Provider, &caller);\n    assert!(admits(&staged.policy, \"3.13.1\"));\n    assert!(!admits(&staged.policy, \"3.12.4\"));\n}\n\n#[test]\nfn several_prefixes_per_source_compose() {\n    let server = policy(\n        serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.12\", \"3.13\"]}}),\n    );\n    let caller = policy(\n        serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.13.1\", \"3\"]}}),\n    );\n    assert_exact_intersection(&server, &caller);\n    let combined = both_orders(&server, &caller);\n    assert!(admits(&combined, \"3.13.1\"));\n    assert!(admits(&combined, \"3.12.4\"));\n    assert!(!admits(&combined, \"2.7.18\"));\n\n    let narrow = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.1\"]}}));\n    let wide = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.13\"]}}));\n    assert_exact_intersection(&narrow, &wide);\n}\n\n#[test]\nfn disjoint_version_restrictions_admit_nothing() {\n    let left = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.12\"]}}));\n    let right = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.13\"]}}));\n    let combined = both_orders(&left, &right);\n    for version in VERSIONS {\n        let decision = decide(&combined, version);\n        assert!(!decision.admitted, \"{version} must stay denied\");\n        assert_eq!(decision.codes(), [\"runtime_version_denied\"]);\n    }\n}\n\n#[test]\nfn identical_and_unrestricted_sources_are_unchanged() {\n    let fine = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3.13\"]}}));\n    let same = both_orders(&fine, &fine);\n    assert_eq!(same.allowed_runtime_versions, fine.allowed_runtime_versions);\n\n    let unrestricted = policy(serde_json::json!({\"version\": 1}));\n    let combined = both_orders(&fine, &unrestricted);\n    assert_eq!(combined.allowed_runtime_versions, fine.allowed_runtime_versions);\n    assert_exact_intersection(&fine, &unrestricted);\n\n    let none = both_orders(&unrestricted, &unrestricted);\n    assert_eq!(none.allowed_runtime_versions, None);\n}\n\n#[test]\nfn other_runtimes_keep_their_own_restrictions() {\n    let python = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"python\": [\"3\"]}}));\n    let node = policy(serde_json::json!({\"version\": 1, \"allowed_runtime_versions\": {\"node\": [\"22\"]}}));\n    let combined = both_orders(&python, &node);\n    let versions = combined.allowed_runtime_versions.unwrap();\n    assert_eq!(versions.get(&RuntimeKind::Python), Some(&vec![\"3\".to_string()]));\n    assert_eq!(versions.get(&RuntimeKind::Node), Some(&vec![\"22\".to_string()]));\n}\n"}}
