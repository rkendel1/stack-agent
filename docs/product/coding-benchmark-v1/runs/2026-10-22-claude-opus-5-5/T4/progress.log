{"decision":"request_capability","capability":"project.write","inputs":{"path":"packages/core/test/multi-version-resolution.test.ts","expect_absent":true,"content":"/**\n * Dependency resolution against providers that serve several versions of one capability\n * (spec/appport-1.0.md §8.3: a server MAY support several versions of one name simultaneously).\n *\n * Compatibility, provider-pinned resolution and resolution across candidate providers must agree on\n * which provided version satisfies a requirement: the highest provided version satisfying the constraint.\n */\n\nimport { describe, it, expect, beforeEach } from \"vitest\";\nimport {\n  defineCapability,\n  defineApplication,\n  implementation,\n  ApplicationRegistry,\n  MemoryApplicationStateStore,\n  ApplicationDependencyResolver,\n  evaluateCompatibility,\n  type RequirementWithConstraints\n} from \"@appport/core\";\nimport { s } from \"@appport/schema\";\n\nfunction invoicingProvider(id: string, versions: readonly number[]) {\n  const provides = versions.map((version) =>\n    defineCapability({\n      name: \"invoice.create\",\n      version,\n      input: s.object({ amount: s.number() }),\n      output: s.object({ id: s.string() }),\n      handler: async () => ({ id: `${id}-v${version}` })\n    })\n  );\n  const implementations = Object.fromEntries(\n    versions.map((version) => [`invoice.create@${version}`, implementation(async () => ({ id: `${id}-v${version}` }))])\n  );\n  return defineApplication({ identity: { id, name: id, version: \"1.0.0\" }, provides, implementations });\n}\n\nfunction consumerApp(version: number, versionConstraint: string) {\n  const orderCreate = defineCapability({\n    name: \"order.create\",\n    version: 1,\n    input: s.object({ amount: s.number() }),\n    output: s.object({ orderId: s.string() }),\n    handler: async () => ({ orderId: \"ord1\" })\n  });\n  return defineApplication({\n    identity: { id: \"commerce\", name: \"Commerce\", version: \"1.0.0\" },\n    provides: [orderCreate],\n    requires: [{ name: \"invoice.create\", version, versionConstraint }],\n    implementations: { \"order.create@1\": implementation(async () => ({ orderId: \"ord1\" })) }\n  });\n}\n\ntype App = ReturnType<typeof defineApplication>;\n\nasync function register(registry: ApplicationRegistry, app: App) {\n  return registry.register({\n    identity: app.identity,\n    manifest: app.manifest(),\n    fingerprint: app.fingerprint(),\n    verification: app.verify()\n  });\n}\n\nconst requirement = (versionConstraint: string, version = 1, providerId?: string): RequirementWithConstraints => ({\n  name: \"invoice.create\",\n  version,\n  versionConstraint,\n  ...(providerId ? { provider: { applicationId: providerId } } : {})\n});\n\ndescribe(\"Resolution against providers serving several capability versions\", () => {\n  let registry: ApplicationRegistry;\n  let resolver: ApplicationDependencyResolver;\n\n  beforeEach(() => {\n    registry = new ApplicationRegistry(new MemoryApplicationStateStore());\n    resolver = new ApplicationDependencyResolver(registry);\n  });\n\n  describe(\"compatibility\", () => {\n    it(\"is compatible with a requirement for any version the provider serves\", async () => {\n      const provider = await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      for (const constraint of [\"1\", \"2\", \"^1\", \"^2\", \"~2\", \">=1\", \">=2\", \">1\", \"<=2\", \"<2\"]) {\n        const result = evaluateCompatibility(requirement(constraint), provider);\n        expect(result, constraint).toEqual({ compatible: true, reasons: [] });\n      }\n    });\n\n    it(\"is incompatible when no served version satisfies the requirement\", async () => {\n      const provider = await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      for (const constraint of [\"3\", \"^3\", \">=3\", \">2\", \"<1\"]) {\n        const result = evaluateCompatibility(requirement(constraint), provider);\n        expect(result.compatible, constraint).toBe(false);\n        expect(result.reasons.length, constraint).toBeGreaterThan(0);\n      }\n    });\n  });\n\n  describe(\"resolution across candidate providers\", () => {\n    it(\"resolves an exact requirement to the version it asks for\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      for (const [constraint, expected] of [[\"1\", 1], [\"2\", 2], [\"^2\", 2], [\"^1\", 1], [\"<2\", 1]] as const) {\n        const result = await resolver.resolveRequirement(requirement(constraint));\n        expect(result.kind, constraint).toBe(\"resolved\");\n        if (result.kind === \"resolved\") {\n          expect(result.provider.id).toBe(\"invoicing\");\n          expect(result.capability.version, constraint).toBe(expected);\n        }\n      }\n    });\n\n    it(\"resolves an open-ended range to the highest satisfying version\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      const result = await resolver.resolveRequirement(requirement(\">=1\"));\n      expect(result.kind).toBe(\"resolved\");\n      if (result.kind === \"resolved\") expect(result.capability.version).toBe(2);\n    });\n\n    it(\"reports unresolved when no served version satisfies the requirement\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      const result = await resolver.resolveRequirement(requirement(\"3\"));\n      expect(result.kind).toBe(\"unresolved\");\n    });\n\n    it(\"selects the highest satisfying version across providers, then keeps ambiguity\", async () => {\n      await register(registry, invoicingProvider(\"provider-a\", [1, 2]));\n      await register(registry, invoicingProvider(\"provider-b\", [1]));\n\n      const highest = await resolver.resolveRequirement(requirement(\">=1\"));\n      expect(highest.kind).toBe(\"resolved\");\n      if (highest.kind === \"resolved\") {\n        expect(highest.provider.id).toBe(\"provider-a\");\n        expect(highest.capability.version).toBe(2);\n      }\n\n      const exactTwo = await resolver.resolveRequirement(requirement(\"2\"));\n      expect(exactTwo.kind).toBe(\"resolved\");\n      if (exactTwo.kind === \"resolved\") {\n        expect(exactTwo.provider.id).toBe(\"provider-a\");\n        expect(exactTwo.capability.version).toBe(2);\n      }\n\n      const exactOne = await resolver.resolveRequirement(requirement(\"1\"));\n      expect(exactOne.kind).toBe(\"ambiguous\");\n      if (exactOne.kind === \"ambiguous\") expect(exactOne.candidates.map((c) => c.id)).toEqual([\"provider-a\", \"provider-b\"]);\n    });\n\n    it(\"keeps the lifecycle preference: an active provider excludes a registered one serving a higher version\", async () => {\n      await register(registry, invoicingProvider(\"provider-a\", [1, 2]));\n      await register(registry, invoicingProvider(\"provider-b\", [1]));\n      await registry.activate(\"provider-b\");\n\n      const result = await resolver.resolveRequirement(requirement(\">=1\"));\n      expect(result.kind).toBe(\"resolved\");\n      if (result.kind === \"resolved\") {\n        expect(result.provider.id).toBe(\"provider-b\");\n        expect(result.capability.version).toBe(1);\n      }\n    });\n\n    it(\"resolves an application's requirement for version 2\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      const consumer = await register(registry, consumerApp(2, \"^2\"));\n      const resolution = await resolver.resolveApplication(consumer);\n      expect(resolution.unresolved).toHaveLength(0);\n      expect(resolution.ambiguous).toHaveLength(0);\n      expect(resolution.resolved).toHaveLength(1);\n      expect(resolution.resolved[0]!.capability.version).toBe(2);\n    });\n  });\n\n  describe(\"provider-pinned resolution\", () => {\n    it(\"resolves to the version the requirement asks for\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      for (const [constraint, expected] of [[\"1\", 1], [\"2\", 2], [\"^2\", 2], [\">=1\", 2]] as const) {\n        const result = await resolver.resolveRequirement(requirement(constraint, 1, \"invoicing\"));\n        expect(result.kind, constraint).toBe(\"resolved\");\n        if (result.kind === \"resolved\") expect(result.capability.version, constraint).toBe(expected);\n      }\n    });\n\n    it(\"is unresolved when the pinned provider serves no satisfying version\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1, 2]));\n      const result = await resolver.resolveRequirement(requirement(\"3\", 1, \"invoicing\"));\n      expect(result.kind).toBe(\"unresolved\");\n    });\n  });\n\n  describe(\"single-version providers\", () => {\n    it(\"resolve as before\", async () => {\n      await register(registry, invoicingProvider(\"invoicing\", [1]));\n      const exact = await resolver.resolveRequirement(requirement(\"1\"));\n      expect(exact.kind).toBe(\"resolved\");\n      if (exact.kind === \"resolved\") expect(exact.capability.version).toBe(1);\n      expect((await resolver.resolveRequirement(requirement(\"2\"))).kind).toBe(\"unresolved\");\n    });\n  });\n});\n"}}
