+//! Composition of `allowed_runtime_versions` across policy sources.
+//!
+//! A version is admitted by the effective policy exactly when every source
+//! admits it, regardless of how detailed each source's restriction is.
+
+use std::collections::BTreeMap;
+
+use compute_core::{
+    IsolationRequirement, NetworkPolicy, PlatformIdentity, ProviderIdentity, ResourceLimits,
+    RuntimeKind, WORKLOAD_SPEC_VERSION, WorkloadBundle, WorkloadSpec,
+};
+use compute_policy::*;
+
+fn contract() -> ExecutionContract {
+    let root = tempfile::tempdir().unwrap();
+    std::fs::write(root.path().join("main.py"), "print('hello')\n").unwrap();
+    let workload = WorkloadSpec {
+        version: WORKLOAD_SPEC_VERSION.into(),
+        runtime: RuntimeKind::Python,
+        runtime_version: None,
+        architecture: None,
+        entrypoint: "main.py".into(),
+        args: vec![],
+        env: BTreeMap::new(),
+        inputs: vec![],
+        outputs: vec![],
+        resources: ResourceLimits::default(),
+        network: NetworkPolicy::None,
+        isolation: IsolationRequirement::default(),
+        dependencies: None,
+    };
+    let bundle = WorkloadBundle::create_from(workload, root.path()).unwrap();
+    ExecutionContract::from_bundle(&bundle, None).unwrap()
+}
+
+fn provider(version: &str) -> ProviderFacts {
+    ProviderFacts {
+        identity: ProviderIdentity::Local { id: "local".into() },
+        distribution_id: None,
+        platform: Some(PlatformIdentity {
+            os: "linux".into(),
+            architecture: "x86_64".into(),
+            runtime_abi: None,
+        }),
+        runtime_version: Some(version.into()),
+    }
+}
+
+fn policy(json: serde_json::Value) -> Policy {
+    Policy::from_json(json.to_string().as_bytes()).unwrap()
+}
+
+fn python(prefixes: &[&str]) -> Policy {
+    policy(serde_json::json!({"version": 1, "allowed_runtime_versions": {"python": prefixes}}))
+}
+
+fn decide(policy: &Policy, version: &str) -> AdmissionDecision {
+    admit(policy, &contract(), &provider(version), &CapabilityStatus::Compatible)
+}
+
+fn compose(server: &Policy, explicit: &Policy) -> EffectivePolicy {
+    let forward = EffectivePolicy::compose(&[
+        (PolicySourceKind::Server, server.clone()),
+        (PolicySourceKind::Explicit, explicit.clone()),
+    ]);
+    let reversed = EffectivePolicy::compose(&[
+        (PolicySourceKind::Explicit, explicit.clone()),
+        (PolicySourceKind::Server, server.clone()),
+    ]);
+    assert_eq!(forward, reversed, "source order does not matter");
+    assert_eq!(
+        server.intersect(explicit),
+        explicit.intersect(server),
+        "intersection is commutative"
+    );
+    forward
+}
+
+/// The effective policy admits a version exactly when every source does.
+fn assert_conjunction(sources: (&Policy, &Policy), versions: &[&str]) {
+    let effective = compose(sources.0, sources.1);
+    for version in versions {
+        let expected = decide(sources.0, version).admitted && decide(sources.1, version).admitted;
+        let decision = admit_effective(
+            &effective,
+            &contract(),
+            &provider(version),
+            &CapabilityStatus::Compatible,
+        );
+        assert_eq!(
+            decision.admitted, expected,
+            "version {version}: {:?}",
+            decision.reasons
+        );
+        if !expected {
+            assert_eq!(decision.codes(), ["runtime_version_denied"]);
+        }
+    }
+}
+
+#[test]
+fn coarse_and_fine_restrictions_admit_a_version_both_allow() {
+    let server = python(&["3"]);
+    let caller = python(&["3.13"]);
+    assert!(decide(&server, "3.13.1").admitted);
+    assert!(decide(&caller, "3.13.1").admitted);
+
+    let effective = compose(&server, &caller);
+    let decision = admit_effective(
+        &effective,
+        &contract(),
+        &provider("3.13.1"),
+        &CapabilityStatus::Compatible,
+    );
+    assert!(decision.admitted, "{:?}", decision.reasons);
+
+    // A version the finer source denies stays denied, and the denial names
+    // the versions that would be admitted.
+    let denied = admit_effective(
+        &effective,
+        &contract(),
+        &provider("3.12.4"),
+        &CapabilityStatus::Compatible,
+    );
+    assert_eq!(denied.codes(), ["runtime_version_denied"]);
+    assert_eq!(denied.reasons[0].allowed, serde_json::json!(["3.13"]));
+
+    assert_conjunction(
+        (&server, &caller),
+        &["3.13.1", "3.13.0rc1", "3.12.4", "3.11", "2.7.18"],
+    );
+}
+
+#[test]
+fn several_prefixes_against_a_coarse_restriction() {
+    let fine = python(&["3.12", "3.13"]);
+    let coarse = python(&["3"]);
+    assert_conjunction(
+        (&fine, &coarse),
+        &["3.12.1", "3.13.1", "3.11.9", "2.7.18"],
+    );
+    let effective = compose(&fine, &coarse);
+    assert!(
+        admit_effective(
+            &effective,
+            &contract(),
+            &provider("3.12.1"),
+            &CapabilityStatus::Compatible
+        )
+        .admitted
+    );
+}
+
+#[test]
+fn disjoint_restrictions_admit_nothing_either_denies() {
+    let left = python(&["3.12"]);
+    let right = python(&["3.13"]);
+    assert_conjunction((&left, &right), &["3.12.1", "3.13.1", "3.11.0"]);
+}
+
+#[test]
+fn identical_restrictions_are_unchanged() {
+    let left = python(&["3.13"]);
+    let effective = compose(&left, &left);
+    assert_eq!(
+        effective.policy.allowed_runtime_versions,
+        left.allowed_runtime_versions
+    );
+    assert_conjunction((&left, &left), &["3.13.1", "3.12.1"]);
+}
+
+#[test]
+fn other_runtimes_and_unrestricted_sources_are_unaffected() {
+    let server = python(&["3"]);
+    let node = policy(serde_json::json!({"version": 1, "allowed_runtime_versions": {"node": ["22"]}}));
+    let effective = compose(&server, &node);
+    let versions = effective.policy.allowed_runtime_versions.clone().unwrap();
+    assert_eq!(versions.get(&RuntimeKind::Python), Some(&vec!["3".to_string()]));
+    assert_eq!(versions.get(&RuntimeKind::Node), Some(&vec!["22".to_string()]));
+    assert_conjunction((&server, &node), &["3.13.1", "2.7.18"]);
+
+    let unrestricted = policy(serde_json::json!({"version": 1}));
+    let effective = compose(&server, &unrestricted);
+    assert_eq!(
+        effective.policy.allowed_runtime_versions,
+        server.allowed_runtime_versions
+    );
+    assert_conjunction((&server, &unrestricted), &["3.13.1", "2.7.18"]);
+}
