+/// Versions both prefix lists admit. A version is admitted by a prefix it
+/// contains, so where one prefix contains another, the more specific one
+/// admits exactly what both do. Unrelated pairs are dropped, which only
+/// ever narrows.
+fn version_prefixes(left: &[String], right: &[String]) -> Vec<String> {
+    let mut result = BTreeSet::new();
+    for left in left {
+        for right in right {
+            if right.contains(left.as_str()) {
+                result.insert(right.clone());
+            } else if left.contains(right.as_str()) {
+                result.insert(left.clone());
+            }
+        }
+    }
+    result.into_iter().collect()
+}
