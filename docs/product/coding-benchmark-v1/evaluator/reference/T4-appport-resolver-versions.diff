+/** The highest version of the required capability the provider serves that satisfies the requirement's constraint. */
+function selectProvidedCapability(
+  requirement: RequirementWithConstraints,
+  provider: ApplicationState
+): CapabilityManifestEntry | undefined {
+  const versionConstraint = requirement.versionConstraint || String(requirement.version);
+  return provider.manifest.provides
+    .filter((cap) => cap.name === requirement.name && satisfiesVersionConstraint(cap.version, versionConstraint))
+    .reduce<CapabilityManifestEntry | undefined>((best, cap) => (!best || cap.version > best.version ? cap : best), undefined);
+}
