{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stack-agent.work-report.v1",
  "title": "stack-agent work --json report, version 1",
  "description": "Fields listed here are stable within version 1: never removed, renamed or reinterpreted. Other fields may appear and are not part of the contract. terminal_state, verified, grounded, goal_satisfied and exit_status come from the runtime's own evaluation of authoritative observations; outcome_reason and answer are text and carry the model's words.",
  "type": "object",
  "required": [
    "audit",
    "build",
    "command",
    "credential_source",
    "ended_by",
    "endpoint",
    "executions_by_capability",
    "exit_status",
    "generation",
    "goal",
    "goal_kind",
    "goal_satisfied",
    "grounded",
    "model",
    "outcome_reason",
    "pax_test",
    "provider",
    "schema",
    "terminal_state",
    "tuning",
    "usage",
    "verified"
  ],
  "properties": {
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "audit": {
      "type": "object"
    },
    "build": {
      "type": "object"
    },
    "capability_requests": {
      "type": "integer"
    },
    "command": {
      "type": "string",
      "const": "work"
    },
    "context": {
      "type": "object"
    },
    "credential_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "delivery": {
      "type": [
        "string",
        "null"
      ]
    },
    "ended_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "endpoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "executions_by_capability": {
      "type": "object"
    },
    "exit_status": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "generation": {
      "type": "object"
    },
    "goal": {
      "type": "string"
    },
    "goal_kind": {
      "type": "string",
      "enum": [
        "change",
        "verify",
        "inspect",
        "act"
      ]
    },
    "goal_satisfied": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "grounded": {
      "type": "boolean"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_failures": {
      "type": "array"
    },
    "outcome_reason": {
      "type": "string"
    },
    "paths_written": {
      "type": "array"
    },
    "pax_test": {
      "type": "object"
    },
    "provider": {
      "type": [
        "string",
        "null"
      ]
    },
    "reads": {
      "type": "integer"
    },
    "receipt": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "type": "string",
      "const": "stack-agent.work-report.v1"
    },
    "terminal_state": {
      "type": "string",
      "enum": [
        "completed",
        "escalated",
        "blocked",
        "limit_reached",
        "failed",
        "cancelled"
      ]
    },
    "tuning": {
      "type": "object"
    },
    "usage": {
      "type": "object"
    },
    "verified": {
      "type": "boolean"
    },
    "write_conflicts": {
      "type": "array"
    },
    "writes": {
      "type": "integer"
    },
    "token_usage": {
      "type": "object",
      "description": "Per-call token accounting (docs/product/token-usage.md). Present unless CHIP_TOKEN_DIAGNOSTICS=off.",
      "required": [
        "schema",
        "accounting",
        "run",
        "calls",
        "totals",
        "data_quality"
      ],
      "properties": {
        "schema": {
          "const": "stack-agent.token-usage.v1"
        },
        "accounting": {
          "type": "object",
          "required": [
            "provider",
            "input_semantics"
          ],
          "properties": {
            "input_semantics": {
              "enum": [
                "cache_separate",
                "cache_included",
                "unknown"
              ]
            }
          }
        },
        "run": {
          "type": "object"
        },
        "calls": {
          "type": "array"
        },
        "totals": {
          "type": "object"
        },
        "by_model": {
          "type": "object"
        },
        "context": {
          "type": "object"
        },
        "observations": {
          "type": "object"
        },
        "time": {
          "type": "object"
        },
        "data_quality": {
          "type": "array"
        }
      }
    },
    "completion": {
      "type": [
        "object",
        "null"
      ],
      "description": "What the model claimed, the candidate change, the tests and when they ran, and what Chip verified, kept apart; independent evaluation is never available to the runtime. Changes no verdict. null for an inspection.",
      "properties": {
        "model_terminal_decision": {
          "enum": [
            "complete",
            "escalate",
            "block",
            null
          ]
        },
        "model_completions_refused": {
          "type": "integer",
          "minimum": 0
        },
        "candidate_change": {
          "type": "object"
        },
        "tests": {
          "type": "object"
        },
        "acceptance_verified_by_runtime": {
          "type": "boolean"
        },
        "evidence_invalidated": {
          "type": "boolean"
        },
        "independent_evaluation": {
          "const": "not_available_to_runtime"
        },
        "terminal_state": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
